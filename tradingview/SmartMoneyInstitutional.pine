vpLvnPct         = input.float(25, "LVN threshold (% of POC)", minval=1,  maxval=60, group=GRP_VP, tooltip="Bins at/below this % of the POC volume are Low Volume Nodes (imbalance / fast-move zones).")
vpShowVA         = input.bool(true,  "Show 70% value area + POC line", group=GRP_VP)
vpPocColor       = input.color(#ffd54f, "POC",  group=GRP_VP, inline="vp1")
