vpBins           = input.int(24,  "Rows (price bins)", minval=6, maxval=50, group=GRP_VP)
vpWidth          = input.int(40,  "Profile width (bars)", minval=10, maxval=150, group=GRP_VP, tooltip="Visual width of the histogram, drawn to the right of price.")
