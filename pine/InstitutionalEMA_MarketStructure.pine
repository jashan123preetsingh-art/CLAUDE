//@version=6
// ════════════════════════════════════════════════════════════════════════════
//  EMA + MARKET STRUCTURE + KEY LEVELS
//  Pine Script v6 · non-repainting · clean institutional layout
//
//  Three proven engines, paired together:
//    1) Triple-EMA trend layer (5 / 50 / 200)
//    2) Market Structure  — clean swing + BOS / CHoCH engine
//                           (logic inspired by "Market Structure" © Leviathan,
//                            swing generation inspired by @BacktestRookies)
//    3) Key Levels        — adaptive, self-aligning S/R zones that flip colour
//                           when broken (logic inspired by "Bjorgum Key Levels"
//                           © Bjorgum). A broken support that flips to resistance
//                           (or vice-versa) is exactly SBR / RBS behaviour, drawn
//                           cleanly instead of with bespoke retest code.
//
//  All three are self-contained here (no external library import) and combined
//  into an optional EMA-confluence signal: structure break, in the direction of
//  the EMA trend, while price sits inside a key zone.
//
//  NON-REPAINT: swings & zones use confirmed ta.pivot* points (fixed lag); zone
//  flips and BOS/CHoCH evaluate on closed bars.
// ════════════════════════════════════════════════════════════════════════════

indicator("EMA + Market Structure + Key Levels", "EMA·MS·KL", overlay = true,
     max_boxes_count = 500, max_labels_count = 500, max_lines_count = 500)

// ─────────────────────────────────────────────────────────────────────────────
//  GROUPS
// ─────────────────────────────────────────────────────────────────────────────
var string G_EMA  = "EMAs"
var string G_MS   = "Market Structure"
var string G_KL   = "Key Levels"
var string G_SIG  = "EMA Confluence Signal"

// ─────────────────────────────────────────────────────────────────────────────
//  EMA INPUTS
// ─────────────────────────────────────────────────────────────────────────────
fastLen   = input.int(5,   "Fast EMA",   minval = 1, group = G_EMA, inline = "f")
fastCol   = input.color(color.white,  "", group = G_EMA, inline = "f")
fastW     = input.int(2,   "W", minval = 1, maxval = 5, group = G_EMA, inline = "f")
showFast  = input.bool(true, "", group = G_EMA, inline = "f")

medLen    = input.int(50,  "Med EMA",    minval = 1, group = G_EMA, inline = "m")
medCol    = input.color(color.orange, "", group = G_EMA, inline = "m")
medW      = input.int(2,   "W", minval = 1, maxval = 5, group = G_EMA, inline = "m")
showMed   = input.bool(true, "", group = G_EMA, inline = "m")

macroLen  = input.int(200, "Macro EMA",  minval = 1, group = G_EMA, inline = "x")
macroCol  = input.color(color.red,    "", group = G_EMA, inline = "x")
macroW    = input.int(3,   "W", minval = 1, maxval = 5, group = G_EMA, inline = "x")
showMacro = input.bool(true, "", group = G_EMA, inline = "x")

showFill  = input.bool(true,  "Fill Fast↔Med", group = G_EMA, inline = "z")
showTrend = input.bool(false, "Trend background", group = G_EMA, inline = "z")

// ─────────────────────────────────────────────────────────────────────────────
//  MARKET STRUCTURE INPUTS  (Leviathan-style)
// ─────────────────────────────────────────────────────────────────────────────
showMS      = input.bool(true,  "Show Market Structure", group = G_MS)
swingSize   = input.int(20, "Swing Length", minval = 1, group = G_MS,
     tooltip = "Bars left & right to confirm a swing pivot. Higher = fewer, more significant swings.")
bosConfType = input.string("Candle Close", "BOS Confirmation", ["Candle Close", "Wicks"], group = G_MS)
showCHOCH   = input.bool(true,  "Rename first counter-trend break to CHoCH", group = G_MS)
showSwing   = input.bool(true,  "Show swing labels (HH/HL/LH/LL)", group = G_MS)
bosColor    = input.color(color.rgb(112, 114, 119), "BOS / CHoCH line", group = G_MS)
bosWidth    = input.int(1, "Width", minval = 1, group = G_MS)

// ─────────────────────────────────────────────────────────────────────────────
//  KEY LEVELS INPUTS  (Bjorgum-style adaptive zones)
// ─────────────────────────────────────────────────────────────────────────────
showKL    = input.bool(true,  "Show Key Levels", group = G_KL)
klLeft    = input.int(20, "Look Left",  minval = 1, group = G_KL, inline = "lr")
klRight   = input.int(15, "Look Right", minval = 1, group = G_KL, inline = "lr")
nPiv      = input.int(4,  "Number of zones each side", minval = 1, maxval = 20, group = G_KL)
klAtrLen  = input.int(30, "ATR Length", minval = 1, group = G_KL)
klMult    = input.float(0.5, "Zone Width (ATR)", minval = 0.1, step = 0.1, group = G_KL,
     tooltip = "Half-zone width = ATR × this (capped by Max Zone %). Standardises width across symbols/timeframes.")
klPer     = input.float(5,  "Max Zone Percent", minval = 0.1, step = 0.5, group = G_KL)
klSrc     = input.string("HA", "Source for Pivots", ["HA", "High/Low Body", "High/Low"], group = G_KL,
     tooltip = "HA averages price action so the zone sits in the support/resistance overlap.")
alignZones= input.bool(true,  "Align / merge overlapping zones", group = G_KL)
klExtend  = input.bool(true,  "Extend zones right", group = G_KL)
klBullBo  = input.color(color.new(#64b5f6, 60), "Support",    group = G_KL, inline = "cb")
klBullBg  = input.color(color.new(#64b5f6, 90), "",           group = G_KL, inline = "cb")
klBearBo  = input.color(color.new(#ffeb3b, 60), "Resistance", group = G_KL, inline = "cr")
klBearBg  = input.color(color.new(#ffeb3b, 90), "",           group = G_KL, inline = "cr")

// ─────────────────────────────────────────────────────────────────────────────
//  EMA CONFLUENCE SIGNAL INPUTS
// ─────────────────────────────────────────────────────────────────────────────
showSig     = input.bool(true,  "Show EMA confluence signals", group = G_SIG,
     tooltip = "BUY = bullish BOS, in the direction of the EMA trend, while price is inside a key zone (SELL = inverse).")
requireZone = input.bool(true,  "Require price inside a key zone", group = G_SIG)
requireEma  = input.bool(true,  "Require EMA trend alignment", group = G_SIG)

// ════════════════════════════════════════════════════════════════════════════
//  EMA TREND LAYER
// ════════════════════════════════════════════════════════════════════════════
emaFast  = ta.ema(close, fastLen)
emaMed   = ta.ema(close, medLen)
emaMacro = ta.ema(close, macroLen)

bullTrend = emaFast > emaMed and emaMed > emaMacro and close > emaMacro
bearTrend = emaFast < emaMed and emaMed < emaMacro and close < emaMacro

pf = plot(showFast  ? emaFast  : na, "Fast EMA",  color = fastCol,  linewidth = fastW)
pm = plot(showMed   ? emaMed   : na, "Med EMA",   color = medCol,   linewidth = medW)
plot(showMacro ? emaMacro : na, "Macro EMA", color = macroCol, linewidth = macroW)

fillCol = bullTrend ? color.new(color.green, 90) : bearTrend ? color.new(color.red, 90) : color.new(color.gray, 94)
fill(pf, pm, color = showFill ? fillCol : na, title = "EMA Fill")

bgcolor(showTrend ? (bullTrend ? color.new(color.green, 94) : bearTrend ? color.new(color.red, 94) : na) : na, title = "Trend BG")

// ════════════════════════════════════════════════════════════════════════════
//  KEY LEVELS ENGINE  (adaptive zones, colour-flip on break)
// ════════════════════════════════════════════════════════════════════════════
sync     = bar_index
confirmed= barstate.isconfirmed
extrap   = klExtend ? extend.right : extend.none

var box[]  pivotHigh = array.new_box()    // resistance-origin zones
var box[]  pivotLows = array.new_box()    // support-origin zones
var bool[] highBull  = array.new_bool()   // current polarity of pivotHigh zones (true = acting as support)
var bool[] lowsBull  = array.new_bool()   // current polarity of pivotLows zones

klAtr    = ta.atr(klAtrLen)
haSrc    = klSrc == "HA"
hiLoSrc  = klSrc == "High/Low"

// Heikin-Ashi body (averaged price action)
f_haBody() =>
    haClose = (open + high + low + close) / 4
    var float haOpen = na
    haOpen := na(haOpen[1]) ? (open + close) / 2 : (nz(haOpen[1]) + nz(haClose[1])) / 2
    [haOpen, haClose]

// extend all boxes in an array to the current bar
f_extend(_x) =>
    if klExtend and array.size(_x) > 0
        for i = 0 to array.size(_x) - 1
            box.set_right(array.get(_x, i), sync)

// box constructor
f_box(_x1, _t, _r, _b, _boCol, _bgCol, _e) =>
    box.new(_x1, _t, _r, _b, xloc = xloc.bar_index, extend = _e, border_color = _boCol, bgcolor = _bgCol)

// add a box + its polarity, capping array length at nPiv (drops oldest)
f_addZone(_xb, _xc, _box, _bull) =>
    array.unshift(_xb, _box)
    array.unshift(_xc, _bull)
    if array.size(_xb) > nPiv
        box.delete(array.pop(_xb))
        array.pop(_xc)

f_getBox(_x, _i) =>
    _b = array.get(_x, _i)
    [box.get_top(_b), box.get_bottom(_b)]

// merge overlapping zones onto the newest box of array _y
f_align(_x, _y) =>
    if array.size(_x) > 0 and array.size(_y) > 0
        [_T, _B] = f_getBox(_y, 0)
        for i = 0 to array.size(_x) - 1
            [_t, _b] = f_getBox(_x, i)
            if (_T > _b and _T < _t) or (_B < _t and _B > _b) or (_T > _t and _B < _b) or (_B > _b and _T < _t)
                box.set_top(array.get(_y, 0), _t)
                box.set_bottom(array.get(_y, 0), _b)

// flip a zone's polarity/colour when price closes through it; return net trend count
f_color(_x, _y) =>
    var int _track = 0
    if array.size(_x) > 0
        for i = 0 to array.size(_x) - 1
            [t_, b_] = f_getBox(_x, i)
            _isBull = array.get(_y, i)
            if close > t_ and not _isBull
                box.set_extend(array.get(_x, i), extend.none)
                array.set(_x, i, f_box(sync, t_, sync, b_, klBullBo, klBullBg, extrap))
                array.set(_y, i, true)
                _track += 1
            if close < b_ and _isBull
                box.set_extend(array.get(_x, i), extend.none)
                array.set(_x, i, f_box(sync, t_, sync, b_, klBearBo, klBearBg, extrap))
                array.set(_y, i, false)
                _track -= 1
    _track

// is price currently overlapping any zone? return [found, isBull]
f_detect(_x, _y) =>
    int  _i = 0
    bool _found = false
    bool _isBull = false
    while not _found and _i < array.size(_x)
        [t_, b_] = f_getBox(_x, _i)
        if low < t_ and high > b_
            _isBull := array.get(_y, _i)
            _found  := true
        _i += 1
    [_found, _isBull]

[haOpen, haClose] = f_haBody()
hiHaBod = math.max(haClose, haOpen)
loHaBod = math.min(haClose, haOpen)
hiBod   = math.max(close, open)
loBod   = math.min(close, open)
srcHigh = haSrc ? hiHaBod : hiLoSrc ? high : hiBod
srcLow  = haSrc ? loHaBod : hiLoSrc ? low  : loBod

pivot_high = ta.pivothigh(srcHigh, klLeft, klRight)
pivot_low  = ta.pivotlow(srcLow,  klLeft, klRight)

perc = close * (klPer / 100)
band = math.min(klAtr * klMult, perc)[klRight] / 2

if showKL and not na(pivot_high) and confirmed
    f_addZone(pivotHigh, highBull, f_box(sync[klRight], pivot_high + band, sync, pivot_high - band, klBearBo, klBearBg, extrap), false)
if showKL and not na(pivot_low) and confirmed
    f_addZone(pivotLows, lowsBull, f_box(sync[klRight], pivot_low + band, sync, pivot_low - band, klBullBo, klBullBg, extrap), true)

if showKL and alignZones
    f_align(pivotHigh, pivotHigh)
    f_align(pivotHigh, pivotLows)
    f_align(pivotLows, pivotLows)
    f_align(pivotLows, pivotHigh)

f_extend(pivotHigh)
f_extend(pivotLows)

trackHigh = f_color(pivotHigh, highBull)
trackLows = f_color(pivotLows, lowsBull)

// zone break events (a zone flipped polarity this bar)
resBreak = trackHigh > trackHigh[1] or trackLows > trackLows[1]   // price broke up through resistance
supBreak = trackHigh < trackHigh[1] or trackLows < trackLows[1]   // price broke down through support

// is price inside a key zone right now, and of which polarity?
[fhit, hBull] = f_detect(pivotHigh, highBull)
[lhit, lBull] = f_detect(pivotLows, lowsBull)
inZone     = fhit or lhit
inZoneBull = (fhit and hBull) or (lhit and lBull)
inZoneBear = (fhit and not hBull) or (lhit and not lBull)

// ════════════════════════════════════════════════════════════════════════════
//  MARKET STRUCTURE ENGINE  (clean swings + BOS / CHoCH)
// ════════════════════════════════════════════════════════════════════════════
pivHi = ta.pivothigh(high, swingSize, swingSize)
pivLo = ta.pivotlow(low,  swingSize, swingSize)

var float prevHigh      = na
var float prevLow       = na
var int   prevHighIndex = na
var int   prevLowIndex  = na
var bool  highActive    = false
var bool  lowActive     = false
var int   prevBreakDir  = 0

bool hh = false
bool lh = false
bool hl = false
bool ll = false

if not na(pivHi)
    if pivHi >= nz(prevHigh, pivHi)
        hh := true
    else
        lh := true
    prevHigh      := pivHi
    highActive    := true
    prevHighIndex := bar_index - swingSize

if not na(pivLo)
    if pivLo >= nz(prevLow, pivLo)
        hl := true
    else
        ll := true
    prevLow      := pivLo
    lowActive    := true
    prevLowIndex := bar_index - swingSize

highSrc = bosConfType == "Candle Close" ? close : high
lowSrc  = bosConfType == "Candle Close" ? close : low

bool highBroken = false
bool lowBroken  = false
if highSrc > prevHigh and highActive
    highBroken := true
    highActive := false
if lowSrc < prevLow and lowActive
    lowBroken := true
    lowActive := false

// CHoCH = first break against the previous break direction
chochUp = highBroken and prevBreakDir == -1
chochDn = lowBroken  and prevBreakDir ==  1

// ── swing labels ────────────────────────────────────────────────────────────
if showMS and showSwing and hh
    label.new(bar_index - swingSize, pivHi, "HH", color = color.rgb(0,0,0,100), style = label.style_label_down, textcolor = chart.fg_color, size = size.tiny)
if showMS and showSwing and lh
    label.new(bar_index - swingSize, pivHi, "LH", color = color.rgb(0,0,0,100), style = label.style_label_down, textcolor = chart.fg_color, size = size.tiny)
if showMS and showSwing and hl
    label.new(bar_index - swingSize, pivLo, "HL", color = color.rgb(0,0,0,100), style = label.style_label_up, textcolor = chart.fg_color, size = size.tiny)
if showMS and showSwing and ll
    label.new(bar_index - swingSize, pivLo, "LL", color = color.rgb(0,0,0,100), style = label.style_label_up, textcolor = chart.fg_color, size = size.tiny)

// ── BOS / CHoCH lines + labels ──────────────────────────────────────────────
if showMS and highBroken
    line.new(prevHighIndex, prevHigh, bar_index, prevHigh, color = bosColor, style = line.style_dashed, width = bosWidth)
    label.new(math.floor(bar_index - (bar_index - prevHighIndex) / 2), prevHigh, (chochUp and showCHOCH) ? "CHoCH" : "BOS", color = color.rgb(0,0,0,100), textcolor = bosColor, size = size.tiny)
    prevBreakDir := 1
if showMS and lowBroken
    line.new(prevLowIndex, prevLow, bar_index, prevLow, color = bosColor, style = line.style_dashed, width = bosWidth)
    label.new(math.floor(bar_index - (bar_index - prevLowIndex) / 2), prevLow, (chochDn and showCHOCH) ? "CHoCH" : "BOS", color = color.rgb(0,0,0,100), textcolor = bosColor, style = label.style_label_up, size = size.tiny)
    prevBreakDir := -1

// ════════════════════════════════════════════════════════════════════════════
//  EMA CONFLUENCE SIGNAL  (pairs all three engines)
// ════════════════════════════════════════════════════════════════════════════
emaBullOK  = not requireEma  or bullTrend
emaBearOK  = not requireEma  or bearTrend
zoneBullOK = not requireZone or inZoneBull
zoneBearOK = not requireZone or inZoneBear

buySignal  = showSig and highBroken and emaBullOK and zoneBullOK
sellSignal = showSig and lowBroken  and emaBearOK and zoneBearOK

plotshape(buySignal,  "BUY",  shape.triangleup,   location.belowbar, color.new(color.green, 0), size = size.small, text = "BUY",  textcolor = color.white)
plotshape(sellSignal, "SELL", shape.triangledown, location.abovebar, color.new(color.red, 0),   size = size.small, text = "SELL", textcolor = color.white)

// ════════════════════════════════════════════════════════════════════════════
//  ALERTS
// ════════════════════════════════════════════════════════════════════════════
alertcondition(buySignal,  "BUY confluence",  "BUY · {{ticker}} {{interval}} · price {{close}}")
alertcondition(sellSignal, "SELL confluence", "SELL · {{ticker}} {{interval}} · price {{close}}")
alertcondition(highBroken, "Bullish BOS/CHoCH", "Bullish break of structure on {{interval}}. Price {{close}}")
alertcondition(lowBroken,  "Bearish BOS/CHoCH", "Bearish break of structure on {{interval}}. Price {{close}}")
alertcondition(resBreak,   "Resistance break", "Resistance key level broke on {{interval}}. Price {{close}}")
alertcondition(supBreak,   "Support break",    "Support key level broke on {{interval}}. Price {{close}}")
