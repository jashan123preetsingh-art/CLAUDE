//@version=6
// ════════════════════════════════════════════════════════════════════════════
//  EMA + MARKET STRUCTURE PRO  ·  v2
//  Pine Script v6 · non-repainting · premium institutional layout
//
//  Engines
//    1) Triple-EMA trend     — 8 (momentum) / 33 (trend) / 200 (macro)
//    2) Market Structure      — strong-BOS / CHoCH with displacement filtering
//                               and ATR-adaptive swing length
//    3) Key Levels            — adaptive demand/supply zones with touch-based
//                               strength (★), premium colours and broken-zone
//                               recolouring (support→orange, resistance→cyan)
//    4) Confidence Engine      — 0-100 score from trend, structure, zone,
//                               displacement, EMA alignment and session
//
//  A signal only prints when EVERYTHING aligns: EMA trend + strong displacement
//  BOS + price in a fresh zone + ATR expansion (no chop) + RR ≥ 1:2 + (optional)
//  session + confidence above threshold.
//
//  NON-REPAINT: swings & zones use confirmed ta.pivot* (fixed lag); breaks and
//  zone state evaluate on closed bars.
//  Structure engine inspired by "Market Structure" © Leviathan; key-level zone
//  concept inspired by "Bjorgum Key Levels" © Bjorgum. Self-contained (no imports).
// ════════════════════════════════════════════════════════════════════════════

indicator("EMA + Market Structure PRO", "EMA·MS PRO", overlay = true,
     max_boxes_count = 500, max_labels_count = 500, max_lines_count = 500)

// ─────────────────────────────────────────────────────────────────────────────
//  GROUPS
// ─────────────────────────────────────────────────────────────────────────────
var string G_EMA  = "EMAs"
var string G_MS   = "Market Structure"
var string G_KL   = "Key Levels"
var string G_SIG  = "Signals & Confidence"
var string G_SES  = "Session Filter"
var string G_UI   = "Dashboard & Visuals"

// ─────────────────────────────────────────────────────────────────────────────
//  EMA INPUTS  (8 / 33 / 200)
// ─────────────────────────────────────────────────────────────────────────────
fastLen   = input.int(8,   "Momentum EMA", minval = 1, group = G_EMA, inline = "f")
fastCol   = input.color(color.white,  "", group = G_EMA, inline = "f")
fastW     = input.int(2,   "W", minval = 1, maxval = 5, group = G_EMA, inline = "f")
showFast  = input.bool(true, "", group = G_EMA, inline = "f")

medLen    = input.int(33,  "Trend EMA",    minval = 1, group = G_EMA, inline = "m")
medCol    = input.color(color.orange, "", group = G_EMA, inline = "m")
medW      = input.int(2,   "W", minval = 1, maxval = 5, group = G_EMA, inline = "m")
showMed   = input.bool(true, "", group = G_EMA, inline = "m")

macroLen  = input.int(200, "Macro EMA",    minval = 1, group = G_EMA, inline = "x")
macroCol  = input.color(color.red,    "", group = G_EMA, inline = "x")
macroW    = input.int(3,   "W", minval = 1, maxval = 5, group = G_EMA, inline = "x")
showMacro = input.bool(true, "", group = G_EMA, inline = "x")

showFill  = input.bool(true, "Fill Momentum↔Trend", group = G_EMA)

// ─────────────────────────────────────────────────────────────────────────────
//  MARKET STRUCTURE INPUTS
// ─────────────────────────────────────────────────────────────────────────────
showMS      = input.bool(true,  "Show Market Structure", group = G_MS)
adaptiveSw  = input.bool(true,  "Adaptive swing length (by ATR)", group = G_MS)
swFixed     = input.int(15, "Fixed swing length", minval = 2, group = G_MS)
swLow       = input.int(10, "Low-vol swing",  minval = 2, group = G_MS, inline = "sw")
swMid       = input.int(15, "Mid-vol swing",  minval = 2, group = G_MS, inline = "sw")
swHigh      = input.int(20, "High-vol swing", minval = 2, group = G_MS, inline = "sw")
bosConfType = input.string("Candle Close", "BOS Confirmation", ["Candle Close", "Wicks"], group = G_MS)
minBodyPct  = input.float(0.60, "Strong-break min body %", minval = 0.1, maxval = 0.95, step = 0.05, group = G_MS)
breakAtr    = input.float(0.15, "Min break beyond structure (ATR)", minval = 0.0, step = 0.05, group = G_MS)
showCHOCH   = input.bool(true,  "Label first counter-trend break as CHoCH", group = G_MS)
showSwing   = input.bool(true,  "Show swing labels (HH/HL/LH/LL)", group = G_MS)
bosColor    = input.color(color.rgb(120, 123, 130), "BOS / CHoCH line", group = G_MS)

// ─────────────────────────────────────────────────────────────────────────────
//  KEY LEVELS INPUTS
// ─────────────────────────────────────────────────────────────────────────────
showKL    = input.bool(true,  "Show Key Levels", group = G_KL)
klLeft    = input.int(20, "Look Left",  minval = 1, group = G_KL, inline = "lr")
klRight   = input.int(15, "Look Right", minval = 1, group = G_KL, inline = "lr")
maxZones  = input.int(10, "Max zones", minval = 2, maxval = 30, group = G_KL)
klAtrLen  = input.int(30, "ATR Length", minval = 1, group = G_KL)
klMult    = input.float(0.5, "Zone Width (ATR)", minval = 0.1, step = 0.1, group = G_KL)
klPer     = input.float(5,  "Max Zone Percent", minval = 0.1, step = 0.5, group = G_KL)
klSrc     = input.string("HA", "Source for Pivots", ["HA", "High/Low Body", "High/Low"], group = G_KL)
mergeZones= input.bool(true,  "Merge & strengthen recurring zones", group = G_KL)
showStars = input.bool(true,  "Show zone strength (★)", group = G_KL)
supCol    = input.color(#2196f3, "Demand / Support", group = G_KL, inline = "c1")
resCol    = input.color(#ffeb3b, "Supply / Resistance", group = G_KL, inline = "c1")
brkSupCol = input.color(#ff9800, "Broken support", group = G_KL, inline = "c2")
brkResCol = input.color(#00e5ff, "Broken resistance", group = G_KL, inline = "c2")

// ─────────────────────────────────────────────────────────────────────────────
//  SIGNAL / CONFIDENCE INPUTS
// ─────────────────────────────────────────────────────────────────────────────
showSig     = input.bool(true,  "Show BUY / SELL signals", group = G_SIG)
minConf     = input.int(85, "Min confidence to signal (%)", minval = 0, maxval = 100, group = G_SIG)
minRR       = input.float(2.0, "Min Risk:Reward", minval = 0.5, step = 0.5, group = G_SIG)
smartFilter = input.bool(true,  "Smart filter (block chop / flat / weak)", group = G_SIG,
     tooltip = "Blocks signals when EMAs are flat, ATR is contracted, the candle body is small, or RR < target.")
slopeMin    = input.float(0.04, "Min EMA slope (ATR/bar)", minval = 0.0, step = 0.01, group = G_SIG)
atrExpMin   = input.float(0.85, "Min ATR expansion (vs avg)", minval = 0.1, step = 0.05, group = G_SIG)

// ─────────────────────────────────────────────────────────────────────────────
//  SESSION INPUTS
// ─────────────────────────────────────────────────────────────────────────────
useSession  = input.bool(false, "Restrict signals to sessions", group = G_SES)
useLondon   = input.bool(true,  "London", group = G_SES, inline = "s1")
useNY       = input.bool(true,  "New York", group = G_SES, inline = "s1")
useAsia     = input.bool(false, "Asia", group = G_SES, inline = "s1")
londonSess  = input.session("0800-1700", "London",   group = G_SES)
nySess      = input.session("1300-2200", "New York", group = G_SES)
asiaSess    = input.session("0000-0900", "Asia",     group = G_SES)
sessTZ      = input.string("GMT", "Session timezone", group = G_SES)

// ─────────────────────────────────────────────────────────────────────────────
//  DASHBOARD & VISUAL INPUTS
// ─────────────────────────────────────────────────────────────────────────────
showDash    = input.bool(true,  "Show dashboard", group = G_UI)
dashPos     = input.string("Top Right", "Position", ["Top Right", "Top Left", "Bottom Right", "Bottom Left"], group = G_UI)
colorCandle = input.bool(false, "Colour candles by trend", group = G_UI)
accentBull  = input.color(#26a69a, "Accent Bull", group = G_UI, inline = "ac")
accentBear  = input.color(#ef5350, "Accent Bear", group = G_UI, inline = "ac")

// ════════════════════════════════════════════════════════════════════════════
//  CORE CALCULATIONS
// ════════════════════════════════════════════════════════════════════════════
emaFast  = ta.ema(close, fastLen)
emaMed   = ta.ema(close, medLen)
emaMacro = ta.ema(close, macroLen)

atr      = ta.atr(klAtrLen)
atrSafe  = atr == 0 or na(atr) ? syminfo.mintick : atr
atrAvg   = ta.sma(atr, 50)
atrRatio = na(atrAvg) or atrAvg == 0 ? 1.0 : atr / atrAvg

body     = math.abs(close - open)
rng      = high - low
rngSafe  = rng == 0 ? syminfo.mintick : rng
bodyPct  = body / rngSafe
displacement = bodyPct >= minBodyPct or rng >= 1.2 * atrSafe

// Trend rules (do NOT require price above 200 EMA — only above the 33)
bullTrend = emaFast > emaMed and emaMed > emaMacro and close > emaMed
bearTrend = emaFast < emaMed and emaMed < emaMacro and close < emaMed
fullBull  = bullTrend and close > emaMacro
fullBear  = bearTrend and close < emaMacro

// EMA slope (ATR-normalised) → flat-market detection
slopeMed = (emaMed - emaMed[3]) / 3 / atrSafe
emaFlat  = math.abs(slopeMed) < slopeMin
ranging  = emaFlat or atrRatio < atrExpMin

// ════════════════════════════════════════════════════════════════════════════
//  EMA PLOTS
// ════════════════════════════════════════════════════════════════════════════
pf = plot(showFast  ? emaFast  : na, "Momentum EMA", color = fastCol,  linewidth = fastW)
pm = plot(showMed   ? emaMed   : na, "Trend EMA",    color = medCol,   linewidth = medW)
plot(showMacro ? emaMacro : na, "Macro EMA", color = macroCol, linewidth = macroW)
fillCol = bullTrend ? color.new(accentBull, 90) : bearTrend ? color.new(accentBear, 90) : color.new(color.gray, 94)
fill(pf, pm, color = showFill ? fillCol : na, title = "EMA Fill")

// ════════════════════════════════════════════════════════════════════════════
//  ADAPTIVE SWING + PIVOTS
// ════════════════════════════════════════════════════════════════════════════
phL = ta.pivothigh(high, swLow,  swLow)
phM = ta.pivothigh(high, swMid,  swMid)
phH = ta.pivothigh(high, swHigh, swHigh)
plL = ta.pivotlow(low,   swLow,  swLow)
plM = ta.pivotlow(low,   swMid,  swMid)
plH = ta.pivotlow(low,   swHigh, swHigh)
phF = ta.pivothigh(high, swFixed, swFixed)
plF = ta.pivotlow(low,   swFixed, swFixed)

regime = atrRatio < 0.8 ? 0 : atrRatio > 1.2 ? 2 : 1
swNow  = adaptiveSw ? (regime == 0 ? swLow : regime == 1 ? swMid : swHigh) : swFixed
pivHi  = adaptiveSw ? (regime == 0 ? phL : regime == 1 ? phM : phH) : phF
pivLo  = adaptiveSw ? (regime == 0 ? plL : regime == 1 ? plM : plH) : plF

// ════════════════════════════════════════════════════════════════════════════
//  MARKET STRUCTURE ENGINE  (strong BOS / CHoCH)
// ════════════════════════════════════════════════════════════════════════════
var float prevHigh      = na
var float prevLow       = na
var int   prevHighIndex = na
var int   prevLowIndex  = na
var bool  highActive    = false
var bool  lowActive     = false
var int   prevBreakDir  = 0
var int   structDir     = 0
var string strucHi      = "—"
var string strucLo      = "—"

if not na(pivHi)
    strucHi := pivHi >= nz(prevHigh, pivHi) ? "HH" : "LH"
    prevHigh      := pivHi
    highActive    := true
    prevHighIndex := bar_index - swNow
    if showMS and showSwing
        label.new(bar_index - swNow, pivHi, strucHi, color = color.rgb(0,0,0,100), style = label.style_label_down, textcolor = chart.fg_color, size = size.tiny)

if not na(pivLo)
    strucLo := pivLo >= nz(prevLow, pivLo) ? "HL" : "LL"
    prevLow      := pivLo
    lowActive    := true
    prevLowIndex := bar_index - swNow
    if showMS and showSwing
        label.new(bar_index - swNow, pivLo, strucLo, color = color.rgb(0,0,0,100), style = label.style_label_up, textcolor = chart.fg_color, size = size.tiny)

highSrc = bosConfType == "Candle Close" ? close : high
lowSrc  = bosConfType == "Candle Close" ? close : low

// strong break = closes beyond structure + body filter + ATR penetration
strongBreakUp = highActive and not na(prevHigh) and highSrc > prevHigh and bodyPct >= minBodyPct and (close - prevHigh) > breakAtr * atrSafe
strongBreakDn = lowActive  and not na(prevLow)  and lowSrc  < prevLow  and bodyPct >= minBodyPct and (prevLow - close) > breakAtr * atrSafe

// any close beyond structure deactivates the level (so we don't re-trigger)
if not na(prevHigh) and highSrc > prevHigh
    highActive := false
if not na(prevLow) and lowSrc < prevLow
    lowActive := false

chochUp = strongBreakUp and prevBreakDir == -1
chochDn = strongBreakDn and prevBreakDir ==  1

if showMS and strongBreakUp
    line.new(prevHighIndex, prevHigh, bar_index, prevHigh, color = bosColor, style = line.style_dashed, width = 1)
    label.new(math.floor(bar_index - (bar_index - prevHighIndex) / 2), prevHigh, (chochUp and showCHOCH) ? "CHoCH" : "BOS", color = color.rgb(0,0,0,100), textcolor = bosColor, size = size.tiny)
    structDir    := 1
    prevBreakDir := 1
if showMS and strongBreakDn
    line.new(prevLowIndex, prevLow, bar_index, prevLow, color = bosColor, style = line.style_dashed, width = 1)
    label.new(math.floor(bar_index - (bar_index - prevLowIndex) / 2), prevLow, (chochDn and showCHOCH) ? "CHoCH" : "BOS", color = color.rgb(0,0,0,100), textcolor = bosColor, style = label.style_label_up, size = size.tiny)
    structDir    := -1
    prevBreakDir := -1

// ════════════════════════════════════════════════════════════════════════════
//  KEY LEVELS ENGINE  (zones with strength, premium colours, broken states)
// ════════════════════════════════════════════════════════════════════════════
sync      = bar_index
confirmed = barstate.isconfirmed
haSrc     = klSrc == "HA"
hiLoSrc   = klSrc == "High/Low"

// parallel arrays describe each zone
var box[]   zBox    = array.new_box()
var float[] zTop    = array.new_float()
var float[] zBot    = array.new_float()
var bool[]  zSup    = array.new_bool()    // true = demand/support origin
var bool[]  zBroken = array.new_bool()
var int[]   zTouch  = array.new_int()
var bool[]  zInside = array.new_bool()    // was price inside last bar (touch debounce)

f_haBody() =>
    haClose = (open + high + low + close) / 4
    var float haOpen = na
    haOpen := na(haOpen[1]) ? (open + close) / 2 : (nz(haOpen[1]) + nz(haClose[1])) / 2
    [haOpen, haClose]

f_zoneCols(_isSup, _broken, _touch) =>
    base   = _broken ? (_isSup ? brkSupCol : brkResCol) : (_isSup ? supCol : resCol)
    bAlpha = int(math.max(10, 60 - _touch * 8))
    [color.new(base, bAlpha), color.new(base, 88)]

f_dropOldest() =>
    if array.size(zBox) > 0
        box.delete(array.pop(zBox))
        array.pop(zTop)
        array.pop(zBot)
        array.pop(zSup)
        array.pop(zBroken)
        array.pop(zTouch)
        array.pop(zInside)

f_addZone(_top, _bot, _isSup) =>
    merged = false
    if mergeZones and array.size(zBox) > 0
        for i = 0 to array.size(zBox) - 1
            if array.get(zSup, i) == _isSup and not array.get(zBroken, i)
                t_ = array.get(zTop, i)
                b_ = array.get(zBot, i)
                if _top >= b_ and _bot <= t_          // overlap → strengthen existing
                    array.set(zTouch, i, array.get(zTouch, i) + 1)
                    array.set(zTop, i, math.max(t_, _top))
                    array.set(zBot, i, math.min(b_, _bot))
                    merged := true
                    break
    if not merged
        [bc, bg] = f_zoneCols(_isSup, false, 1)
        b = box.new(sync[klRight], _top, sync, _bot, xloc = xloc.bar_index, border_color = bc, bgcolor = bg)
        array.unshift(zBox, b)
        array.unshift(zTop, _top)
        array.unshift(zBot, _bot)
        array.unshift(zSup, _isSup)
        array.unshift(zBroken, false)
        array.unshift(zTouch, 1)
        array.unshift(zInside, false)
        if array.size(zBox) > maxZones
            f_dropOldest()

[haOpen, haClose] = f_haBody()
srcHigh = haSrc ? math.max(haClose, haOpen) : hiLoSrc ? high : math.max(close, open)
srcLow  = haSrc ? math.min(haClose, haOpen) : hiLoSrc ? low  : math.min(close, open)

pivot_high = ta.pivothigh(srcHigh, klLeft, klRight)
pivot_low  = ta.pivotlow(srcLow,  klLeft, klRight)
perc = close * (klPer / 100)
band = math.min(atr * klMult, perc)[klRight] / 2

if showKL and not na(pivot_high) and confirmed
    f_addZone(pivot_high + band, pivot_high - band, false)
if showKL and not na(pivot_low) and confirmed
    f_addZone(pivot_low + band, pivot_low - band, true)

// per-bar zone maintenance: touches, break state, colour, extend
var bool newSupBreak = false
var bool newResBreak = false
newSupBreak := false
newResBreak := false

if array.size(zBox) > 0
    for i = 0 to array.size(zBox) - 1
        t_ = array.get(zTop, i)
        b_ = array.get(zBot, i)
        isSup  = array.get(zSup, i)
        broken = array.get(zBroken, i)
        // break detection (close through the zone)
        if not broken
            if isSup and close < b_
                array.set(zBroken, i, true)
                newSupBreak := true
            if not isSup and close > t_
                array.set(zBroken, i, true)
                newResBreak := true
        // touch detection with debounce
        nowInside = high >= b_ and low <= t_
        if nowInside and not array.get(zInside, i) and not array.get(zBroken, i)
            array.set(zTouch, i, array.get(zTouch, i) + 1)
        array.set(zInside, i, nowInside)
        // recolour + size
        [bc, bg] = f_zoneCols(isSup, array.get(zBroken, i), array.get(zTouch, i))
        bx = array.get(zBox, i)
        box.set_top(bx, t_)
        box.set_bottom(bx, b_)
        box.set_right(bx, sync)
        box.set_border_color(bx, bc)
        box.set_bgcolor(bx, bg)

// zone star labels (redrawn on last bar only to stay clean)
var label[] starLabs = array.new_label()
if showKL and showStars and barstate.islast
    if array.size(starLabs) > 0
        for j = 0 to array.size(starLabs) - 1
            label.delete(array.get(starLabs, j))
        array.clear(starLabs)
    if array.size(zBox) > 0
        for i = 0 to array.size(zBox) - 1
            if not array.get(zBroken, i)
                n = int(math.min(5, array.get(zTouch, i)))
                stars = str.repeat("★", n) + str.repeat("☆", 5 - n)
                isSup = array.get(zSup, i)
                lab = label.new(sync + 3, isSup ? array.get(zBot, i) : array.get(zTop, i), stars,
                     color = color.rgb(0,0,0,100), style = isSup ? label.style_label_up : label.style_label_down,
                     textcolor = isSup ? supCol : resCol, size = size.tiny)
                array.push(starLabs, lab)

// ── nearest zones & "price in zone" state ───────────────────────────────────
f_nearestSupport() =>
    float lvl = na
    if array.size(zBox) > 0
        for i = 0 to array.size(zBox) - 1
            if array.get(zSup, i) and not array.get(zBroken, i) and array.get(zTop, i) <= close
                if na(lvl) or array.get(zTop, i) > lvl
                    lvl := array.get(zTop, i)
    lvl

f_nearestResistance() =>
    float lvl = na
    if array.size(zBox) > 0
        for i = 0 to array.size(zBox) - 1
            if not array.get(zSup, i) and not array.get(zBroken, i) and array.get(zBot, i) >= close
                if na(lvl) or array.get(zBot, i) < lvl
                    lvl := array.get(zBot, i)
    lvl

f_inZone(_wantSup) =>
    bool hit = false
    if array.size(zBox) > 0
        for i = 0 to array.size(zBox) - 1
            if array.get(zSup, i) == _wantSup and not array.get(zBroken, i)
                if high >= array.get(zBot, i) and low <= array.get(zTop, i)
                    hit := true
    hit

nearSup = f_nearestSupport()
nearRes = f_nearestResistance()
inDemand = f_inZone(true)
inSupply = f_inZone(false)

// SL/TP references for RR (buy uses structure low / demand; sell uses structure high / supply)
slLong  = na(prevLow)  ? close - atrSafe : math.min(prevLow, na(nearSup) ? prevLow : nearSup) - 0.1 * atrSafe
slShort = na(prevHigh) ? close + atrSafe : math.max(prevHigh, na(nearRes) ? prevHigh : nearRes) + 0.1 * atrSafe
tpLong  = na(nearRes) ? close + (close - slLong) * minRR : nearRes
tpShort = na(nearSup) ? close - (slShort - close) * minRR : nearSup
rrLong  = close - slLong  > 0 ? (tpLong - close) / (close - slLong) : 0.0
rrShort = slShort - close > 0 ? (close - tpShort) / (slShort - close) : 0.0

// ════════════════════════════════════════════════════════════════════════════
//  SESSION FILTER
// ════════════════════════════════════════════════════════════════════════════
inLondon = useLondon and not na(time(timeframe.period, londonSess, sessTZ))
inNY     = useNY     and not na(time(timeframe.period, nySess, sessTZ))
inAsia   = useAsia   and not na(time(timeframe.period, asiaSess, sessTZ))
inSess   = not useSession or inLondon or inNY or inAsia
sessName = inLondon and inNY ? "London+NY" : inLondon ? "London" : inNY ? "New York" : inAsia ? "Asia" : useSession ? "Closed" : "—"

// ════════════════════════════════════════════════════════════════════════════
//  CONFIDENCE ENGINE  (0-100)
// ════════════════════════════════════════════════════════════════════════════
f_conf(_bull) =>
    int s = 0
    if _bull
        s += bullTrend ? 20 : 0
        s += (structDir == 1 ? 20 : structDir == 0 ? 8 : 0)
        s += inDemand ? 20 : 0
        s += displacement ? 20 : 0
        s += fullBull ? 10 : 0
        s += inSess ? 10 : 0
    else
        s += bearTrend ? 20 : 0
        s += (structDir == -1 ? 20 : structDir == 0 ? 8 : 0)
        s += inSupply ? 20 : 0
        s += displacement ? 20 : 0
        s += fullBear ? 10 : 0
        s += inSess ? 10 : 0
    s
confBull = f_conf(true)
confBear = f_conf(false)
confShow = bullTrend ? confBull : bearTrend ? confBear : math.max(confBull, confBear)

// ════════════════════════════════════════════════════════════════════════════
//  SIGNALS  (all engines must align)
// ════════════════════════════════════════════════════════════════════════════
chopBlock = smartFilter and (ranging or bodyPct < 0.45)
buySignal  = showSig and bullTrend and strongBreakUp and displacement and inDemand and confBull >= minConf and rrLong  >= minRR and inSess and not chopBlock
sellSignal = showSig and bearTrend and strongBreakDn and displacement and inSupply and confBear >= minConf and rrShort >= minRR and inSess and not chopBlock

if buySignal
    label.new(bar_index, low, "BUY  " + str.tostring(confBull) + "%", yloc = yloc.belowbar, style = label.style_label_up, color = accentBull, textcolor = color.white, size = size.small)
if sellSignal
    label.new(bar_index, high, "SELL  " + str.tostring(confBear) + "%", yloc = yloc.abovebar, style = label.style_label_down, color = accentBear, textcolor = color.white, size = size.small)

// ════════════════════════════════════════════════════════════════════════════
//  CANDLE COLOURING
// ════════════════════════════════════════════════════════════════════════════
pullback  = (bullTrend and close < emaFast) or (bearTrend and close > emaFast)
candleCol = not colorCandle ? na : pullback ? color.new(color.gray, 30) : bullTrend ? #1b5e20 : bearTrend ? #7f1d1d : color.new(color.gray, 40)
barcolor(candleCol, title = "Trend candles")

// ════════════════════════════════════════════════════════════════════════════
//  DASHBOARD
// ════════════════════════════════════════════════════════════════════════════
f_pos() =>
    dashPos == "Top Right" ? position.top_right : dashPos == "Top Left" ? position.top_left : dashPos == "Bottom Right" ? position.bottom_right : position.bottom_left

trendTxt = fullBull ? "STRONG BULL" : bullTrend ? "BULLISH" : fullBear ? "STRONG BEAR" : bearTrend ? "BEARISH" : "NEUTRAL"
trendCol = bullTrend ? accentBull : bearTrend ? accentBear : color.gray
momTxt   = math.abs(emaFast - emaFast[3]) > atrSafe * 0.10 ? "Strong" : "Weak"
sigTxt   = buySignal ? "BUY" : sellSignal ? "SELL" : "—"

var table dash = na

// dashboard cell helper (global scope — Pine forbids functions inside blocks)
f_cell(_r, _k, _v, _c) =>
    table.cell(dash, 0, _r, _k, text_color = color.new(color.silver, 0), text_size = size.small, text_halign = text.align_left,  bgcolor = color.new(#0e0f13, 10))
    table.cell(dash, 1, _r, _v, text_color = _c, text_size = size.small, text_halign = text.align_right, bgcolor = color.new(#0e0f13, 10))

if showDash and barstate.islast
    if not na(dash)
        table.delete(dash)
    dash := table.new(f_pos(), 2, 8, bgcolor = color.new(#0e0f13, 10), border_color = color.new(color.gray, 70), border_width = 1, frame_color = color.new(color.gray, 60), frame_width = 1)
    table.cell(dash, 0, 0, "EMA·MS PRO", text_color = color.white, text_size = size.normal, bgcolor = color.new(trendCol, 25))
    table.cell(dash, 1, 0, syminfo.ticker + " " + timeframe.period, text_color = color.white, text_size = size.small, bgcolor = color.new(trendCol, 25))
    f_cell(1, "Trend",      trendTxt, trendCol)
    f_cell(2, "Momentum",   momTxt,   momTxt == "Strong" ? color.white : color.gray)
    f_cell(3, "Structure",  strucHi + "  " + strucLo, structDir == 1 ? accentBull : structDir == -1 ? accentBear : color.gray)
    f_cell(4, "Nearest Demand",     na(nearSup) ? "—" : str.tostring(nearSup, format.mintick), supCol)
    f_cell(5, "Nearest Resistance", na(nearRes) ? "—" : str.tostring(nearRes, format.mintick), resCol)
    f_cell(6, "Session",    sessName, sessName == "Closed" ? color.gray : color.white)
    confC = confShow >= 85 ? accentBull : confShow >= 60 ? color.orange : color.gray
    table.cell(dash, 0, 7, "Confidence", text_color = color.white, text_size = size.small, text_halign = text.align_left, bgcolor = color.new(confC, 30))
    table.cell(dash, 1, 7, str.tostring(confShow) + "%  " + sigTxt, text_color = color.white, text_size = size.normal, text_halign = text.align_right, bgcolor = color.new(confC, 30))

// ════════════════════════════════════════════════════════════════════════════
//  ALERTS  (rich multi-line messages)
// ════════════════════════════════════════════════════════════════════════════
f_msg(_dir, _conf) =>
    _dir + "\nTrend : " + trendTxt + "\nConfidence : " + str.tostring(_conf) + "%" +
         "\nStructure : " + ((_dir == "BUY" and chochUp) or (_dir == "SELL" and chochDn) ? "CHoCH" : "BOS") +
         "\nZone : " + (_dir == "BUY" ? "Demand" : "Supply") +
         "\nSymbol : " + syminfo.ticker + "\nTF : " + timeframe.period

if buySignal
    alert(f_msg("BUY", confBull), alert.freq_once_per_bar_close)
if sellSignal
    alert(f_msg("SELL", confBear), alert.freq_once_per_bar_close)

alertcondition(buySignal,     "BUY signal",        "BUY confluence · {{ticker}} {{interval}} · {{close}}")
alertcondition(sellSignal,    "SELL signal",       "SELL confluence · {{ticker}} {{interval}} · {{close}}")
alertcondition(strongBreakUp, "Bullish Strong BOS","Bullish strong BOS/CHoCH on {{interval}} · {{close}}")
alertcondition(strongBreakDn, "Bearish Strong BOS","Bearish strong BOS/CHoCH on {{interval}} · {{close}}")
alertcondition(newSupBreak,   "Support broken",    "Support zone broken on {{interval}} · {{close}}")
alertcondition(newResBreak,   "Resistance broken", "Resistance zone broken on {{interval}} · {{close}}")
