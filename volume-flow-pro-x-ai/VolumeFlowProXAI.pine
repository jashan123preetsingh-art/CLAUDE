// ============================================================================
//  VOLUME FLOW PRO X AI  —  The Ultimate Day Trading Workspace
// ----------------------------------------------------------------------------
//  An institutional Volume Profile + VWAP trading workspace for TradingView.
//  This is not a buy/sell signal indicator. It is a decision-support terminal
//  built on four primitives only: Price, Volume, VWAP and the Volume Profile.
//
//  Design goals: Bloomberg/Bookmap-grade clarity, minimal chart clutter,
//  non-repainting, replay-compatible, memory-bounded object usage.
//
//  Architecture (matches the project module map):
//    M1  Fixed Range Volume Profile (POC / VAH / VAL / HVN / LVN)
//    M2  Anchored VWAP
//    M3  Professional VWAP Suite (Daily / Weekly / Monthly + slope)
//    M4  Standard Deviation Bands
//    M8  Volume Flow Engine (relative volume rating, pressure)
//    M9  Smart Price Action (trend / swings / S&R)
//    M12 Market Condition Engine
//    M13 Trade Quality Engine (0-100 score)
//    M14 / M21  AI Trade Plan Engine (WAIT / BUY ZONE / SELL ZONE)
//    M15 Professional Dashboard
//    M16 Smart Alerts
//    M17 Clean Chart Engine (bounded object recycling)
//    M18 Customization
//  ============================================================================

indicator("Volume Flow Pro X AI", shorttitle="VF Pro X AI", overlay=true, max_lines_count=500, max_labels_count=500, max_boxes_count=500, max_bars_back=1500)

// ============================================================================
//  THEME & COLOR SYSTEM  (M18 / M20)
// ============================================================================
grpTheme = "◈  Theme & Appearance"
themeMode   = input.string("Dark Glass", "Theme", options=["Dark Glass", "Light"], group=grpTheme)
accentTransp = input.int(80, "Dashboard Opacity (lower = solid)", minval=40, maxval=95, group=grpTheme, tooltip="Glass transparency of the dashboard background. 80 ≈ soft glass.")

// Elegant institutional palette — no rainbow, every hue has a job.
cBull   = input.color(#26a69a, "Bullish",   group=grpTheme, inline="c1")
cBear   = input.color(#ef5350, "Bearish",   group=grpTheme, inline="c1")
cVwap   = input.color(#4fc3f7, "VWAP (Sky)", group=grpTheme, inline="c2")
cPoc    = input.color(#ffca28, "POC (Gold)", group=grpTheme, inline="c2")
cVah    = input.color(#ffa726, "VAH (Orange)", group=grpTheme, inline="c3")
cVal    = input.color(#ab47bc, "VAL (Purple)", group=grpTheme, inline="c3")
cHvn    = input.color(#42a5f5, "HVN (Blue)", group=grpTheme, inline="c4")
cLvn    = input.color(#90a4ae, "LVN (Gray)", group=grpTheme, inline="c4")
cSup    = input.color(#42a5f5, "Support",    group=grpTheme, inline="c5")
cRes    = input.color(#ffa726, "Resistance", group=grpTheme, inline="c5")

isLight = themeMode == "Light"
cPanelBg   = isLight ? color.new(#ffffff, accentTransp - 20) : color.new(#0d1117, accentTransp)
cPanelHdr  = isLight ? color.new(#eef2f7, 10) : color.new(#161b22, 10)
cText      = isLight ? color.new(#1c2330, 0) : color.new(#e6edf3, 0)
cTextDim   = isLight ? color.new(#5b6573, 0) : color.new(#8b949e, 0)
cFrame     = isLight ? color.new(#c9d2dd, 30) : color.new(#30363d, 30)
cGrid      = isLight ? color.new(#d6dde6, 40) : color.new(#21262d, 30)

// ============================================================================
//  GLOBAL TOGGLES  (M18)
// ============================================================================
grpShow = "◈  Modules"
showProfile  = input.bool(true,  "Volume Profile (FRVP)", group=grpShow)
showVwapD    = input.bool(true,  "Daily VWAP + Bands",    group=grpShow)
showVwapW    = input.bool(true,  "Weekly VWAP",           group=grpShow)
showVwapM    = input.bool(false, "Monthly VWAP",          group=grpShow)
showAnchored = input.bool(false, "Anchored VWAP",         group=grpShow)
showKeyLvls  = input.bool(true,  "Key Day Levels (PDH/PDL/OR)", group=grpShow)
showSR       = input.bool(true,  "Support / Resistance",  group=grpShow)
showDash     = input.bool(true,  "Professional Dashboard",group=grpShow)
showPlanLbl  = input.bool(true,  "Trade Plan Label on chart", group=grpShow)

// ============================================================================
//  M1 — FIXED RANGE VOLUME PROFILE  (inputs)
// ============================================================================
grpVP = "◈  Volume Profile (M1 / M6 / M7)"
vpMode    = input.string("Auto (Lookback)", "Range Mode", options=["Auto (Lookback)", "Session", "Manual Bars"], group=grpVP, tooltip="Auto = rolling lookback window. Session = current trading day. Manual = fixed bar count ending now.")
vpLookback= input.int(260, "Lookback Bars", minval=20, maxval=1500, group=grpVP)
vpBins    = input.int(40, "Profile Resolution (rows)", minval=12, maxval=120, group=grpVP, tooltip="Number of price bins. Higher = finer profile, slightly more CPU.")
vpWidthBars = input.int(60, "Profile Width (bars)", minval=10, maxval=300, group=grpVP, tooltip="Width of the histogram drawn in the chart margin, measured in bars.")
vpGapBars   = input.int(5, "Gap From Last Candle (bars)", minval=1, maxval=60, group=grpVP, tooltip="Empty space between the most recent candle and the profile so candles stay unobstructed.")
vpSide    = input.string("Right", "Profile Side", options=["Right", "Left"], group=grpVP, tooltip="Right = bars grow rightward from the gap. Left = bars grow leftward toward price (TradingView-style), still inside the margin.")
vaPercent = input.float(70, "Value Area %", minval=50, maxval=90, group=grpVP)
vpProfTransp = input.int(78, "Profile Transparency", minval=40, maxval=95, group=grpVP)
showHVNLVN  = input.bool(true, "Show Top HVN / LVN levels", group=grpVP)
maxNodes    = input.int(2, "Top N HVN / LVN to draw", minval=1, maxval=3, group=grpVP, tooltip="Day-trader default keeps the chart clean: 2 each.")

// ============================================================================
//  M3 — VWAP SUITE  (inputs)
// ============================================================================
grpVWAP = "◈  VWAP Suite (M3 / M4)"
vwapSrc   = input.source(hlc3, "VWAP Source", group=grpVWAP)
showBands = input.bool(true, "Daily VWAP Std-Dev Bands", group=grpVWAP)
band1Mult = input.float(1.0, "Band ±σ (1)", minval=0.1, step=0.1, group=grpVWAP, inline="b")
band2Mult = input.float(2.0, "Band ±σ (2)", minval=0.1, step=0.1, group=grpVWAP, inline="b")
vwapWidth = input.int(2, "VWAP Line Width", minval=1, maxval=4, group=grpVWAP)

// ============================================================================
//  M2 — ANCHORED VWAP  (inputs)
// ============================================================================
grpAVWAP = "◈  Anchored VWAP (M2)"
avwapAnchorTime = input.time(timestamp("01 Jan 2024 00:00 +0000"), "Anchor Point", group=grpAVWAP, confirm=true, tooltip="Click a candle on the chart to anchor the VWAP, or set a date.")

// ============================================================================
//  M9 — PRICE ACTION / TREND  (inputs)
// ============================================================================
grpPA = "◈  Price Action & Trend (M9 / M12)"
swingLen  = input.int(10, "Swing Pivot Strength", minval=2, maxval=50, group=grpPA, tooltip="Higher = fewer, more significant swing points for market structure.")
volMaLen  = input.int(20, "Relative Volume Length", minval=5, maxval=200, group=grpPA)

// ============================================================================
//  M13 / M14 — TRADE PLAN ENGINE  (inputs)
// ============================================================================
grpAI = "◈  AI Trade Plan (M13 / M14 / M21)"
scoreThreshold = input.int(70, "Min Trade Score to arm a plan", minval=50, maxval=95, group=grpAI, tooltip="Below this, the engine stays in WAIT to protect against overtrading.")
atrLenRisk = input.int(14, "ATR Length (stops/targets)", minval=5, maxval=50, group=grpAI)
posState   = input.string("None", "Active Position (for management guidance)", options=["None", "Long", "Short"], group=grpAI, tooltip="Set this when you are in a trade to unlock Manage / Move-Stop / Take-Partial / Exit guidance. Purely advisory — the script does not track fills.")

// ============================================================================
//  M15 — DASHBOARD  (inputs)
// ============================================================================
grpDash = "◈  Dashboard (M15)"
dashPos  = input.string("Top Right", "Position", options=["Top Right", "Top Left", "Bottom Right", "Bottom Left", "Middle Right"], group=grpDash)
dashSize = input.string("Normal", "Size", options=["Tiny", "Small", "Normal", "Large"], group=grpDash)

// ============================================================================
//  MULTI-TIMEFRAME POC & RANKED KEY LEVELS  (inputs)
// ============================================================================
grpMTF = "◈  Multi-Timeframe & Key Levels"
showMTFpoc   = input.bool(true,  "Multi-Timeframe POC (Daily / Weekly / Monthly)", group=grpMTF, tooltip="Where institutions traded most across higher timeframes. Approximated from intraday bars, capped for performance.")
showKeyPanel = input.bool(true,  "Ranked Key Levels panel (top 5)", group=grpMTF)
keyPos       = input.string("Middle Right", "Key Levels Position", options=["Top Right", "Top Left", "Bottom Right", "Bottom Left", "Middle Right", "Middle Left"], group=grpMTF)

// ============================================================================
//  SESSION INTELLIGENCE  (inputs)
// ============================================================================
grpSess = "◈  Session Intelligence"
showSession  = input.bool(true,  "Session Intelligence (ADR / IB / active session)", group=grpSess)
sessTz       = input.string("America/New_York", "Session Timezone", options=["America/New_York", "Europe/London", "Asia/Kolkata", "Asia/Tokyo", "Asia/Shanghai", "UTC", "Australia/Sydney"], group=grpSess, tooltip="The timezone the session ranges below are expressed in.")
asiaSess     = input.session("1800-0300", "Asia Session",     group=grpSess)
londonSess   = input.session("0300-0930", "London Session",   group=grpSess)
nySess       = input.session("0930-1600", "New York Session", group=grpSess)
adrLen       = input.int(14, "ADR Length (days)", minval=3, maxval=60, group=grpSess)
ibMinutes    = input.int(60, "Initial Balance (minutes)", minval=5, maxval=240, group=grpSess)

// ============================================================================
//  AUCTION MARKET THEORY & MORNING BRIEF  (inputs)
// ============================================================================
grpAuction = "◈  Auction Market Theory"
showAuction = input.bool(true, "Auction shape / Day-Type analysis", group=grpAuction)

grpBrief = "◈  AI Morning Brief"
showBrief = input.bool(true, "AI Morning Brief panel", group=grpBrief)
briefPos  = input.string("Bottom Left", "Brief Position", options=["Top Right", "Top Left", "Bottom Right", "Bottom Left", "Middle Right", "Middle Left"], group=grpBrief)

// ============================================================================
//  AI MARKET GPS  (inputs)
// ============================================================================
grpGPS = "◈  AI Market GPS"
showGPS = input.bool(true, "Market GPS panel (price location)", group=grpGPS)
gpsPos  = input.string("Top Left", "GPS Position", options=["Top Right", "Top Left", "Bottom Right", "Bottom Left", "Middle Right", "Middle Left"], group=grpGPS)

// ============================================================================
//  HELPERS
// ============================================================================
f_tblPos(p) =>
    switch p
        "Top Right"     => position.top_right
        "Top Left"      => position.top_left
        "Bottom Right"  => position.bottom_right
        "Bottom Left"   => position.bottom_left
        "Middle Right"  => position.middle_right
        "Middle Left"   => position.middle_left
        => position.top_right

f_txtSize(s) =>
    switch s
        "Tiny"   => size.tiny
        "Small"  => size.small
        "Normal" => size.normal
        "Large"  => size.large
        => size.normal

// Round to symbol tick for clean display
f_px(x) => str.tostring(math.round_to_mintick(x))

// Star strength rating (1-5) for ranked key levels
f_stars(s) => s >= 5 ? "★★★★★" : s == 4 ? "★★★★" : s == 3 ? "★★★" : s == 2 ? "★★" : "★"

// ============================================================================
//  M3 / M4 — VWAP SUITE (manual, full control over slope + bands, no repaint)
// ----------------------------------------------------------------------------
//  Manual accumulation lets us expose variance (for σ bands) and slope, and
//  keeps everything calculated bar-by-bar so it is replay/realtime consistent.
// ============================================================================
f_vwap(src, anchorCond) =>
    var float sumPV  = 0.0
    var float sumV   = 0.0
    var float sumP2V = 0.0
    if anchorCond
        sumPV  := 0.0
        sumV   := 0.0
        sumP2V := 0.0
    vol = nz(volume)
    sumPV  += src * vol
    sumV   += vol
    sumP2V += src * src * vol
    vw  = sumV > 0 ? sumPV / sumV : src
    varc = sumV > 0 ? math.max(sumP2V / sumV - vw * vw, 0.0) : 0.0
    dev = math.sqrt(varc)
    [vw, dev]

newDay   = timeframe.change("D")
newWeek  = timeframe.change("W")
newMonth = timeframe.change("M")

[vwapD, devD] = f_vwap(vwapSrc, newDay)
[vwapW, _devW] = f_vwap(vwapSrc, newWeek)
[vwapM, _devM] = f_vwap(vwapSrc, newMonth)
[vwapA, _devA] = f_vwap(vwapSrc, time == avwapAnchorTime or (time > avwapAnchorTime and time[1] < avwapAnchorTime))

// Daily VWAP bands
vwapD_u1 = vwapD + devD * band1Mult
vwapD_l1 = vwapD - devD * band1Mult
vwapD_u2 = vwapD + devD * band2Mult
vwapD_l2 = vwapD - devD * band2Mult

// VWAP slope / direction (M3) — normalized by ATR so it is symbol-agnostic
atr14 = ta.atr(atrLenRisk)
vwapSlope = (vwapD - vwapD[3]) / (atr14 == 0 ? syminfo.mintick : atr14)
vwapDir = vwapSlope > 0.06 ? "Rising" : vwapSlope < -0.06 ? "Falling" : "Flat"
vwapDColor = vwapDir == "Rising" ? cBull : vwapDir == "Falling" ? cBear : cTextDim

// ---- VWAP plots ----
pVwapD = plot(showVwapD ? vwapD : na, "Daily VWAP", color=vwapDColor, linewidth=vwapWidth)
pU1 = plot(showVwapD and showBands ? vwapD_u1 : na, "VWAP +1σ", color=color.new(cVwap, 55), linewidth=1)
pL1 = plot(showVwapD and showBands ? vwapD_l1 : na, "VWAP -1σ", color=color.new(cVwap, 55), linewidth=1)
pU2 = plot(showVwapD and showBands ? vwapD_u2 : na, "VWAP +2σ", color=color.new(cVwap, 75), linewidth=1)
pL2 = plot(showVwapD and showBands ? vwapD_l2 : na, "VWAP -2σ", color=color.new(cVwap, 75), linewidth=1)
fill(pU1, pL1, color=showVwapD and showBands ? color.new(cVwap, 92) : na, title="VWAP 1σ fill")
fill(pU2, pU1, color=showVwapD and showBands ? color.new(cVwap, 95) : na, title="VWAP 2σ upper fill")
fill(pL1, pL2, color=showVwapD and showBands ? color.new(cVwap, 95) : na, title="VWAP 2σ lower fill")

plot(showVwapW ? vwapW : na, "Weekly VWAP", color=color.new(cVwap, 30), linewidth=1, style=plot.style_line)
plot(showVwapM ? vwapM : na, "Monthly VWAP", color=color.new(#7e57c2, 20), linewidth=1, style=plot.style_line)
plot(showAnchored ? vwapA : na, "Anchored VWAP", color=color.new(#ffb74d, 10), linewidth=2, style=plot.style_line)

// ============================================================================
//  PILLAR 2 — MARKET STRUCTURE ENGINE  (pure price action, NO moving averages)
// ----------------------------------------------------------------------------
//  Trend is derived from swing structure (HH/HL/LH/LL) + breakouts — never
//  from EMAs/RSI. This is one input to the composite Trend Engine below.
// ============================================================================
ph = ta.pivothigh(high, swingLen, swingLen)
pl = ta.pivotlow(low, swingLen, swingLen)
var float sH1 = na   // most recent confirmed swing high
var float sH2 = na   // previous swing high
var float sL1 = na   // most recent confirmed swing low
var float sL2 = na   // previous swing low
if not na(ph)
    sH2 := sH1
    sH1 := ph
if not na(pl)
    sL2 := sL1
    sL1 := pl
lastResistance = sH1   // kept for level drawing + decision proximity
lastSupport    = sL1

HH = not na(sH1) and not na(sH2) and sH1 > sH2
LH = not na(sH1) and not na(sH2) and sH1 < sH2
HL = not na(sL1) and not na(sL2) and sL1 > sL2
LL = not na(sL1) and not na(sL2) and sL1 < sL2
breakoutUp = not na(sH1) and close > sH1
breakoutDn = not na(sL1) and close < sL1

structBull = HH and HL
structBear = LL and LH
structureTxt = HH and HL ? "HH · HL" : LL and LH ? "LH · LL" : breakoutUp ? "Breakout ↑" : breakoutDn ? "Breakout ↓" : (HH and LL) ? "Expansion" : (LH and HL) ? "Compression" : "Transition"
structScore = (HH ? 1.0 : 0.0) + (HL ? 1.0 : 0.0) - (LH ? 1.0 : 0.0) - (LL ? 1.0 : 0.0) + (breakoutUp ? 0.5 : 0.0) - (breakoutDn ? 0.5 : 0.0)

// Structure-derived trend booleans (consumed by scoring + decision layers)
trendUp  = structBull or (breakoutUp and not LL)
trendDn  = structBear or (breakoutDn and not HH)
trendStr = math.min(math.abs(structScore), 3.0)

// ============================================================================
//  M8 — VOLUME FLOW ENGINE
// ============================================================================
volMa = ta.sma(volume, volMaLen)
relVol = volMa > 0 ? volume / volMa : 1.0
// Buying vs selling pressure from where price closes within the bar, weighted by volume
barRange = high - low
buyP  = barRange > 0 ? (close - low) / barRange : 0.5
pressure = ta.ema((buyP - 0.5) * 2 * relVol, 9)   // >0 buyers, <0 sellers
pressureTxt = pressure > 0.25 ? "Strong Buyers" : pressure > 0.05 ? "Buyers" : pressure < -0.25 ? "Strong Sellers" : pressure < -0.05 ? "Sellers" : "Balanced"
pressureColor = pressure > 0.05 ? cBull : pressure < -0.05 ? cBear : cTextDim

// ============================================================================
//  M1 / M6 / M7 — FIXED RANGE VOLUME PROFILE ENGINE
// ----------------------------------------------------------------------------
//  Computed once on the last bar for performance. Each historical bar's volume
//  is distributed across the price bins it overlaps (proportional to overlap),
//  which is far more accurate than dumping volume into a single bin.
// ============================================================================
// Determine the working range length (nz guards the first bars before any
// session change has occurred, when ta.barssince() is still na)
sessLen = nz(ta.barssince(newDay), bar_index) + 1
rangeLen = vpMode == "Session" ? math.min(sessLen, 1440) : vpMode == "Manual Bars" ? vpLookback : vpLookback
rangeLen := math.max(rangeLen, 10)

rngTop = ta.highest(high, rangeLen)
rngBot = ta.lowest(low, rangeLen)

var float[] binVol = array.new_float(vpBins, 0.0)
var box[]   vpBoxes = array.new_box()
var line[]  vpLines = array.new_line()
var label[] vpLabels= array.new_label()

// Outputs of the profile engine (persist for dashboard / plan)
var float pocPrice = na
var float vahPrice = na
var float valPrice = na
var float hvn1 = na
var float hvn2 = na
var float lvn1 = na
var float lvn2 = na

// Auction Market Theory outputs (computed inside the profile engine on last bar)
var string auctionShape = "—"
var bool   poorHigh = false
var bool   poorLow  = false

f_clearDrawings() =>
    if array.size(vpBoxes) > 0
        for b in vpBoxes
            box.delete(b)
        array.clear(vpBoxes)
    if array.size(vpLines) > 0
        for l in vpLines
            line.delete(l)
        array.clear(vpLines)
    if array.size(vpLabels) > 0
        for la in vpLabels
            label.delete(la)
        array.clear(vpLabels)

// Standalone POC calculator over a bar lookback (for Multi-Timeframe POC).
// Runs only on the last bar; top/bot are pre-computed series passed in so the
// stateful ta.* calls stay on every bar. Lookback is capped by the caller.
f_pocBin(topP, botP, lb, bins) =>
    float poc = na
    if topP > botP and lb >= 2
        float bs = (topP - botP) / bins
        arr = array.new_float(bins, 0.0)
        for i = 0 to lb - 1
            float bh = high[i]
            float bl = low[i]
            float bv = nz(volume[i])
            float br = bh - bl
            if br <= 0
                idx = math.min(math.max(int((close[i] - botP) / bs), 0), bins - 1)
                array.set(arr, idx, array.get(arr, idx) + bv)
            else
                lo = math.min(math.max(int((bl - botP) / bs), 0), bins - 1)
                hi = math.min(math.max(int((bh - botP) / bs), 0), bins - 1)
                for j = lo to hi
                    float bb = botP + j * bs
                    float bt = bb + bs
                    float ov = math.min(bh, bt) - math.max(bl, bb)
                    if ov > 0
                        array.set(arr, j, array.get(arr, j) + bv * ov / br)
        float mx = array.max(arr)
        int pidx = array.indexof(arr, mx)
        poc := botP + (pidx + 0.5) * bs
    poc

// Full profile (POC + Value Area) over a bar window at a history offset.
// Used by the Market Memory Engine to read today's vs yesterday's auction.
f_profileOff(topP, botP, startOff, lb, bins) =>
    float poc = na
    float vah = na
    float val = na
    if topP > botP and lb >= 2
        float bs = (topP - botP) / bins
        arr = array.new_float(bins, 0.0)
        for i = 0 to lb - 1
            int off = startOff + i
            float bh = high[off]
            float bl = low[off]
            float bv = nz(volume[off])
            float br = bh - bl
            if br <= 0
                idx = math.min(math.max(int((close[off] - botP) / bs), 0), bins - 1)
                array.set(arr, idx, array.get(arr, idx) + bv)
            else
                lo = math.min(math.max(int((bl - botP) / bs), 0), bins - 1)
                hi = math.min(math.max(int((bh - botP) / bs), 0), bins - 1)
                for j = lo to hi
                    float bb = botP + j * bs
                    float bt = bb + bs
                    float ov = math.min(bh, bt) - math.max(bl, bb)
                    if ov > 0
                        array.set(arr, j, array.get(arr, j) + bv * ov / br)
        float mx = array.max(arr)
        int pidx = array.indexof(arr, mx)
        poc := botP + (pidx + 0.5) * bs
        float totV = array.sum(arr)
        float target = totV * vaPercent / 100.0
        float acc = mx
        int up = pidx
        int dn = pidx
        int g = 0
        while acc < target and (up < bins - 1 or dn > 0) and g < bins * 2
            float vUp = up < bins - 1 ? array.get(arr, up + 1) : -1.0
            float vDn = dn > 0 ? array.get(arr, dn - 1) : -1.0
            if vUp >= vDn
                up += 1
                acc += vUp
            else
                dn -= 1
                acc += vDn
            g += 1
        vah := botP + (up + 1) * bs
        val := botP + dn * bs
    [poc, vah, val]

// Push a ranked key-level candidate into the working arrays (skips na prices)
f_addLvl(parr, narr, sarr, p, n, s) =>
    if not na(p)
        array.push(parr, p)
        array.push(narr, n)
        array.push(sarr, s)

// Draw a horizontal level line + right-aligned label (global so it is reusable)
f_level(price, col, txt, styl, lx, rx) =>
    ln = line.new(lx, price, rx, price, color=col, width=1, style=styl, xloc=xloc.bar_index)
    array.push(vpLines, ln)
    la = label.new(rx, price, txt + "  " + f_px(price), xloc=xloc.bar_index, style=label.style_label_left, color=color.new(col, 85), textcolor=col, size=size.small)
    array.push(vpLabels, la)

if barstate.islast
    f_clearDrawings()
    array.fill(binVol, 0.0)
    float top = rngTop
    float bot = rngBot
    float binSize = (top - bot) / vpBins
    if binSize > 0
        // ---- distribute volume into bins ----
        for i = 0 to rangeLen - 1
            float bh = high[i]
            float bl = low[i]
            float bv = nz(volume[i])
            float brange = bh - bl
            if brange <= 0
                idx = math.min(math.max(int((close[i] - bot) / binSize), 0), vpBins - 1)
                array.set(binVol, idx, array.get(binVol, idx) + bv)
            else
                loIdx = math.min(math.max(int((bl - bot) / binSize), 0), vpBins - 1)
                hiIdx = math.min(math.max(int((bh - bot) / binSize), 0), vpBins - 1)
                for j = loIdx to hiIdx
                    binBot = bot + j * binSize
                    binTop = binBot + binSize
                    overlap = math.min(bh, binTop) - math.max(bl, binBot)
                    if overlap > 0
                        array.set(binVol, j, array.get(binVol, j) + bv * overlap / brange)

        // ---- POC ----
        float maxV = array.max(binVol)
        int pocIdx = array.indexof(binVol, maxV)
        pocPrice := bot + (pocIdx + 0.5) * binSize

        // ---- Value Area (expand from POC to vaPercent of total volume) ----
        float totalV = array.sum(binVol)
        float vaTarget = totalV * vaPercent / 100.0
        float acc = maxV
        int up = pocIdx
        int dn = pocIdx
        int guard = 0
        while acc < vaTarget and (up < vpBins - 1 or dn > 0) and guard < vpBins * 2
            float vUp = up < vpBins - 1 ? array.get(binVol, up + 1) : -1.0
            float vDn = dn > 0 ? array.get(binVol, dn - 1) : -1.0
            if vUp >= vDn
                up += 1
                acc += vUp
            else
                dn -= 1
                acc += vDn
            guard += 1
        vahPrice := bot + (up + 1) * binSize
        valPrice := bot + dn * binSize

        // ---- HVN / LVN detection (local maxima / minima vs average) ----
        float avgV = totalV / vpBins
        hvn1 := na
        hvn2 := na
        lvn1 := na
        lvn2 := na
        float hvn1v = 0.0
        float hvn2v = 0.0
        float lvn1v = 1e30
        float lvn2v = 1e30
        for k = 1 to vpBins - 2
            float v  = array.get(binVol, k)
            float vp = array.get(binVol, k - 1)
            float vn = array.get(binVol, k + 1)
            float price = bot + (k + 0.5) * binSize
            isHVN = v > vp and v > vn and v > avgV * 1.1 and k != pocIdx
            isLVN = v < vp and v < vn and v < avgV * 0.6
            if isHVN
                if v > hvn1v
                    hvn2 := hvn1
                    hvn2v := hvn1v
                    hvn1 := price
                    hvn1v := v
                else if v > hvn2v
                    hvn2 := price
                    hvn2v := v
            if isLVN
                if v < lvn1v
                    lvn2 := lvn1
                    lvn2v := lvn1v
                    lvn1 := price
                    lvn1v := v
                else if v < lvn2v
                    lvn2 := price
                    lvn2v := v

        // ---- Auction Market Theory: profile shape, poor highs/lows, single prints ----
        float pocLoc = vpBins > 1 ? pocIdx / float(vpBins - 1) : 0.5
        auctionShape := pocLoc > 0.66 ? "P-shape (Accum.)" : pocLoc < 0.34 ? "b-shape (Distrib.)" : "D-shape (Balanced)"
        poorHigh := array.get(binVol, vpBins - 1) > avgV * 0.7
        poorLow  := array.get(binVol, 0) > avgV * 0.7

        // ---- DRAW the profile in the RIGHT MARGIN (never over the candles) ----
        // The histogram is anchored a few bars to the RIGHT of the last candle,
        // in the empty future area Pine allows drawing into (xloc.bar_index +
        // offset). Bars never cross back into price, so candles stay clean.
        int profStart = bar_index + vpGapBars            // left edge of the margin profile
        int maxW      = vpWidthBars                       // full width (bars) of the widest row (POC)
        int profEnd   = profStart + maxW                  // right edge of the margin profile
        if showProfile
            for i = 0 to vpBins - 1
                float v = array.get(binVol, i)
                if v > 0
                    int w = math.max(int(maxW * v / maxV), 1)
                    float binBot = bot + i * binSize
                    float binTop = binBot + binSize
                    inVA = (binBot + binSize/2) <= vahPrice and (binBot + binSize/2) >= valPrice
                    isPocBin = i == pocIdx
                    col = isPocBin ? color.new(cPoc, vpProfTransp - 25) : inVA ? color.new(cHvn, vpProfTransp) : color.new(cTextDim, vpProfTransp + 8)
                    // Right: grow rightward from the gap. Left: grow leftward from the far edge (toward price).
                    int x1 = vpSide == "Right" ? profStart : profEnd - w
                    int x2 = vpSide == "Right" ? profStart + w : profEnd
                    array.push(vpBoxes, box.new(x1, binTop, x2, binBot, border_width=0, bgcolor=col, xloc=xloc.bar_index))

        // ---- DRAW POC / VAH / VAL levels + labels ----
        // Lines run across the range and into the profile; labels sit just
        // beyond the profile's right edge so text never lands on candles.
        int lineLeft  = bar_index - rangeLen + 1
        int lineRight = profEnd
        f_level(pocPrice, cPoc, "POC", line.style_solid, lineLeft, lineRight)
        f_level(vahPrice, cVah, "VAH", line.style_dashed, lineLeft, lineRight)
        f_level(valPrice, cVal, "VAL", line.style_dashed, lineLeft, lineRight)

        if showHVNLVN
            if not na(hvn1) and maxNodes >= 1
                f_level(hvn1, cHvn, "HVN", line.style_dotted, lineLeft, lineRight)
            if not na(hvn2) and maxNodes >= 2
                f_level(hvn2, cHvn, "HVN", line.style_dotted, lineLeft, lineRight)
            if not na(lvn1) and maxNodes >= 1
                f_level(lvn1, cLvn, "LVN", line.style_dotted, lineLeft, lineRight)
            if not na(lvn2) and maxNodes >= 2
                f_level(lvn2, cLvn, "LVN", line.style_dotted, lineLeft, lineRight)

// ============================================================================
//  KEY DAY-TRADER LEVELS (PDH / PDL / PDC / Opening Range)  (M21 / workflow)
// ============================================================================
[pdh, pdl, pdc] = request.security(syminfo.tickerid, "D", [high[1], low[1], close[1]], lookahead=barmerge.lookahead_on)

// Initial Balance = first N minutes of the session (the auction's opening range)
var float orH = na
var float orL = na
var int   orBars = 0
barsPerOR = math.max(int(ibMinutes / math.max(timeframe.in_seconds() / 60, 1)), 1)
if newDay
    orH := high
    orL := low
    orBars := 1
else if orBars > 0 and orBars < barsPerOR
    orH := math.max(orH, high)
    orL := math.min(orL, low)
    orBars += 1

var line lnPDH = na
var line lnPDL = na
var line lnPDC = na
var line lnORH = na
var line lnORL = na
var label lbPDH = na
var label lbPDL = na

if barstate.islast and showKeyLvls
    line.delete(lnPDH)
    line.delete(lnPDL)
    line.delete(lnPDC)
    line.delete(lnORH)
    line.delete(lnORL)
    label.delete(lbPDH)
    label.delete(lbPDL)
    lx1 = bar_index - 80
    lx2 = bar_index + vpGapBars + vpWidthBars + 2
    lnPDH := line.new(lx1, pdh, lx2, pdh, color=color.new(cRes, 35), style=line.style_dashed, xloc=xloc.bar_index)
    lnPDL := line.new(lx1, pdl, lx2, pdl, color=color.new(cSup, 35), style=line.style_dashed, xloc=xloc.bar_index)
    lnPDC := line.new(lx1, pdc, lx2, pdc, color=color.new(cTextDim, 40), style=line.style_dotted, xloc=xloc.bar_index)
    lbPDH := label.new(lx2, pdh, "PDH " + f_px(pdh), xloc=xloc.bar_index, style=label.style_label_left, color=color.new(cRes, 88), textcolor=cRes, size=size.small)
    lbPDL := label.new(lx2, pdl, "PDL " + f_px(pdl), xloc=xloc.bar_index, style=label.style_label_left, color=color.new(cSup, 88), textcolor=cSup, size=size.small)
    if not na(orH)
        lnORH := line.new(lx1, orH, lx2, orH, color=color.new(cVah, 55), style=line.style_solid, xloc=xloc.bar_index)
        lnORL := line.new(lx1, orL, lx2, orL, color=color.new(cVal, 55), style=line.style_solid, xloc=xloc.bar_index)
        array.push(vpLabels, label.new(lx2, orH, "IB H", xloc=xloc.bar_index, style=label.style_label_left, color=color.new(cVah, 90), textcolor=cVah, size=size.tiny))

// Support / Resistance pivots (M9)
var line lnSup = na
var line lnRes = na
if barstate.islast and showSR
    line.delete(lnSup)
    line.delete(lnRes)
    if not na(lastSupport)
        lnSup := line.new(bar_index - 60, lastSupport, bar_index + 6, lastSupport, color=color.new(cSup, 45), width=1, xloc=xloc.bar_index)
    if not na(lastResistance)
        lnRes := line.new(bar_index - 60, lastResistance, bar_index + 6, lastResistance, color=color.new(cRes, 45), width=1, xloc=xloc.bar_index)

// ============================================================================
//  MARKET CONDITION PRIMITIVES  (volatility + value membership; feed the brain)
// ============================================================================
atrPct = atr14 / close * 100
atrPctMa = ta.sma(atrPct, 50)
volState = atrPct > atrPctMa * 1.3 ? "High Volatility" : atrPct < atrPctMa * 0.7 ? "Low Volatility" : "Normal"
inValueArea = not na(vahPrice) and not na(valPrice) and close <= vahPrice and close >= valPrice

// ============================================================================
//  PRO ENGINES — MTF POC · Session Intelligence · Flow %
// ============================================================================
// ---- Buyers vs Sellers participation (delta approximation from bar location) ----
buyersPct  = math.round(math.max(0, math.min(100, ta.ema(buyP, 14) * 100)))
sellersPct = 100 - buyersPct
flowColor  = buyersPct >= 60 ? cBull : buyersPct <= 40 ? cBear : cTextDim

// ---- Multi-Timeframe POC + Market Memory (today's vs yesterday's auction) ----
// Track the bar index of the last two session opens to window the profiles.
var int dOpen1 = na   // today's first bar index
var int dOpen0 = na   // yesterday's first bar index
if newDay
    dOpen0 := dOpen1
    dOpen1 := bar_index

int mtfCap = 1000
dPocLen = math.max(math.min(nz(ta.barssince(newDay),   bar_index) + 1, mtfCap), 1)
wPocLen = math.max(math.min(nz(ta.barssince(newWeek),  bar_index) + 1, mtfCap), 1)
mPocLen = math.max(math.min(nz(ta.barssince(newMonth), bar_index) + 1, mtfCap), 1)
dPocTop = ta.highest(high, dPocLen)
dPocBot = ta.lowest(low,  dPocLen)
wPocTop = ta.highest(high, wPocLen)
wPocBot = ta.lowest(low,  wPocLen)
mPocTop = ta.highest(high, mPocLen)
mPocBot = ta.lowest(low,  mPocLen)
// Window lengths capped so the yesterday offset stays inside the history buffer
memTodayLen = math.min(dPocLen, 720)
memYestLen  = (na(dOpen0) or na(dOpen1)) ? 0 : math.max(math.min(dOpen1 - dOpen0, 720), 0)
var float dPOC = na
var float dVAH = na
var float dVAL = na
var float yPOC = na   // yesterday's POC / value area (Market Memory)
var float yVAH = na
var float yVAL = na
var float wPOC = na
var float mPOC = na
if barstate.islast and showMTFpoc
    [tp, tvh, tvl] = f_profileOff(dPocTop, dPocBot, 0, memTodayLen, vpBins)
    dPOC := tp
    dVAH := tvh
    dVAL := tvl
    wPOC := f_pocBin(wPocTop, wPocBot, wPocLen, vpBins)
    mPOC := f_pocBin(mPocTop, mPocBot, mPocLen, vpBins)
    if memYestLen >= 2 and not na(pdh) and not na(pdl) and pdh > pdl
        [yp, yvh, yvl] = f_profileOff(pdh, pdl, memTodayLen, memYestLen, vpBins)
        yPOC := yp
        yVAH := yvh
        yVAL := yvl

// ---- Session Intelligence: active session, ADR, today's range, expected range ----
inAsia   = not na(time(timeframe.period, asiaSess, sessTz))
inLondon = not na(time(timeframe.period, londonSess, sessTz))
inNY     = not na(time(timeframe.period, nySess, sessTz))
activeSession = inNY ? "New York" : inLondon ? "London" : inAsia ? "Asia" : "Off-Hours"
var float volAsia   = 0.0
var float volLondon = 0.0
var float volNY     = 0.0
if newDay
    volAsia   := 0.0
    volLondon := 0.0
    volNY     := 0.0
volAsia   += inAsia ? nz(volume) : 0.0
volLondon += inLondon ? nz(volume) : 0.0
volNY     += inNY ? nz(volume) : 0.0
bestSession = volNY >= volLondon and volNY >= volAsia ? "New York" : volLondon >= volAsia ? "London" : "Asia"

adr          = request.security(syminfo.tickerid, "D", ta.sma(high - low, adrLen)[1], lookahead=barmerge.lookahead_on)
todayH       = request.security(syminfo.tickerid, "D", high)
todayL       = request.security(syminfo.tickerid, "D", low)
dayOpen      = request.security(syminfo.tickerid, "D", open)
[pwh, pwl]   = request.security(syminfo.tickerid, "W", [high[1], low[1]], lookahead=barmerge.lookahead_on)  // prev week H/L (Market Memory)
todayRange   = todayH - todayL
rangeUsedPct = not na(adr) and adr > 0 ? math.round(todayRange / adr * 100) : na
expLow       = not na(adr) ? dayOpen - adr / 2 : na
expHigh      = not na(adr) ? dayOpen + adr / 2 : na

// ============================================================================
//  ███  THE BRAIN — Five-Layer Auction Intelligence Hierarchy  ███
//  Phase  →  Auction (40%)  →  Structure (30%)  →  VWAP (20%)  →  Participation (10%)
//  Every status and decision flows through this order. The job is to EXPLAIN the
//  current auction context in plain English — never to predict price.
// ============================================================================

// ---- LAYER 5: PARTICIPATION (10%) — is the move supported by real volume? ----
volExpand   = relVol >= 1.3
volContract = relVol <= 0.7
partBias    = pressure > 0.05 ? 1.0 : pressure < -0.05 ? -1.0 : 0.0
partConfirm = relVol >= 1.0
partTxt     = volExpand ? "Expanding" : volContract ? "Contracting" : "Steady"

// ---- LAYER 2: AUCTION INTELLIGENCE (40%) — where is value & who controls it? ----
priceVsValue = na(vahPrice) ? "—" : close > vahPrice ? "Above Value" : close < valPrice ? "Below Value" : "Inside Value"
acceptUp = not na(vahPrice) and close > vahPrice and relVol >= 0.9
acceptDn = not na(valPrice) and close < valPrice and relVol >= 0.9
rejUp    = not na(vahPrice) and high > vahPrice and close <= vahPrice
rejDn    = not na(valPrice) and low  < valPrice and close >= valPrice
valueMid = not na(pdh) and not na(pdl) ? (pdh + pdl) / 2 : na
pocMigUp = not na(dPOC) and not na(valueMid) and dPOC > valueMid
pocMigDn = not na(dPOC) and not na(valueMid) and dPOC < valueMid
aScore = 0.0
aScore += not na(pocPrice) and close > pocPrice ? 1.0 : not na(pocPrice) and close < pocPrice ? -1.0 : 0.0
aScore += acceptUp ? 1.0 : acceptDn ? -1.0 : 0.0
aScore += pocMigUp ? 0.7 : pocMigDn ? -0.7 : 0.0
aScore += rejUp ? -0.7 : rejDn ? 0.7 : 0.0
aScore := math.max(math.min(aScore, 2.0), -2.0)
auctionTxt   = acceptUp ? "Acceptance ↑" : acceptDn ? "Acceptance ↓" : rejUp ? "Rejection (high)" : rejDn ? "Rejection (low)" : inValueArea ? "Balanced" : "Rotation"
auctionColor = aScore >= 1.0 ? cBull : aScore <= -1.0 ? cBear : cTextDim

// ---- LAYER 4: VWAP INTELLIGENCE (20%) — cheap / fair / expensive vs fair value ----
vScore = 0.0
vScore += close > vwapD ? 1.0 : -1.0
vScore += not na(vwapW) ? (close > vwapW ? 0.5 : -0.5) : 0.0
vScore += vwapDir == "Rising" ? 0.5 : vwapDir == "Falling" ? -0.5 : 0.0
vScore := math.max(math.min(vScore, 2.0), -2.0)
vwapDist     = (close - vwapD) / (atr14 == 0 ? syminfo.mintick : atr14)
vwapContext  = vwapDist > 1.5 ? "Expensive" : vwapDist < -1.5 ? "Cheap" : "Fair Value"
vwapStateTxt = (close > vwapD ? "Above" : "Below") + " Daily"

// ---- LAYER 1: MARKET PHASE (highest priority) — what environment are we in? ----
openingWindow  = nz(ta.barssince(newDay), bar_index) < barsPerOR
expandingMkt   = atrPct > atrPctMa * 1.25 or breakoutUp or breakoutDn
compressingMkt = atrPct < atrPctMa * 0.75
strongTrend    = (structBull or structBear) and trendStr >= 2 and partConfirm
marketPhase = openingWindow and not na(orH) and (close > orH or close < orL) ? "Opening Drive" : strongTrend and (acceptUp or acceptDn) ? "Trend Day" : (structBull and HL and close > vwapD and not breakoutUp) ? "Pullback" : (structBear and LH and close < vwapD and not breakoutDn) ? "Pullback" : (rejUp or rejDn) ? "Reversal" : expandingMkt and (structBull or structBear) ? "Expansion" : compressingMkt ? "Compression" : (inValueArea and not expandingMkt) ? "Balanced Auction" : (structBull or structBear) ? "Continuation" : "Rotational"
marketPhaseColor = marketPhase == "Trend Day" or marketPhase == "Opening Drive" or marketPhase == "Continuation" ? cBull : marketPhase == "Reversal" ? cVah : (marketPhase == "Balanced Auction" or marketPhase == "Rotational" or marketPhase == "Compression") ? cTextDim : cText
// Phase governs confidence and whether trend trades are allowed at all
phaseMult        = marketPhase == "Trend Day" or marketPhase == "Opening Drive" ? 1.1 : (marketPhase == "Balanced Auction" or marketPhase == "Rotational" or marketPhase == "Compression") ? 0.7 : marketPhase == "Reversal" ? 0.8 : 1.0
phaseAllowsTrend = not (marketPhase == "Balanced Auction" or marketPhase == "Rotational" or marketPhase == "Compression")

// ---- ADAPTIVE MARKET LOGIC (M6): weight pillars by the active phase ----
trendPhase = marketPhase == "Trend Day" or marketPhase == "Opening Drive" or marketPhase == "Continuation"
balPhase   = marketPhase == "Balanced Auction" or marketPhase == "Rotational"
wA = balPhase ? 0.50 : trendPhase ? 0.35 : 0.40   // balanced day → trust value more
wS = balPhase ? 0.20 : trendPhase ? 0.35 : 0.30   // trend day → trust structure more
wV = 0.20
wP = 0.10

// ---- COMPOSITE TREND ENGINE — weighted blend of the four pillars (no MAs) ----
aN = aScore / 2.0
sN = math.max(math.min(structScore / 2.0, 1.0), -1.0)
vN = vScore / 2.0
pN = partBias
composite  = aN * wA + sN * wS + vN * wV + pN * wP   // -1 .. +1
biasScore  = composite
marketBias = composite >= 0.5 ? "Strong Bullish" : composite >= 0.18 ? "Bullish" : composite <= -0.5 ? "Strong Bearish" : composite <= -0.18 ? "Bearish" : "Neutral"
biasColor  = composite >= 0.18 ? cBull : composite <= -0.18 ? cBear : cTextDim

// ---- RISK READ (is this a high- or low-quality location to act?) ----
riskTxt   = (marketPhase == "Balanced Auction" or marketPhase == "Rotational" or inValueArea) ? "High" : (strongTrend and partConfirm) ? "Low" : "Medium"
riskColor = riskTxt == "Low" ? cBull : riskTxt == "High" ? cBear : cTextDim

// ============================================================================
//  M1 — MARKET MEMORY ENGINE  (today's auction vs yesterday's)
// ============================================================================
todayVAmid = (not na(dVAH) and not na(dVAL)) ? (dVAH + dVAL) / 2 : na
yestVAmid  = (not na(yVAH) and not na(yVAL)) ? (yVAH + yVAL) / 2 : na
memOpenLoc = na(yVAH) ? "—" : dayOpen > yVAH ? "Opened above yest. value" : dayOpen < yVAL ? "Opened below yest. value" : "Opened inside yest. value"
memPOCdir  = (na(dPOC) or na(yPOC)) ? "—" : dPOC > yPOC + syminfo.mintick ? "POC higher" : dPOC < yPOC - syminfo.mintick ? "POC lower" : "POC flat"
valueMigration = (na(todayVAmid) or na(yestVAmid)) ? "—" : todayVAmid > yestVAmid + syminfo.mintick ? "Value migrating higher" : todayVAmid < yestVAmid - syminfo.mintick ? "Value migrating lower" : "Value unchanged"
memColor   = valueMigration == "Value migrating higher" ? cBull : valueMigration == "Value migrating lower" ? cBear : cTextDim
pdAccept   = na(pdh) ? "—" : (close > pdh and relVol >= 0.9) ? "PDH accepted" : (high > pdh and close < pdh) ? "PDH rejected" : (close < pdl and relVol >= 0.9) ? "PDL accepted" : (low < pdl and close > pdl) ? "PDL rejected" : "Inside prev day"
pwAccept   = na(pwh) ? "—" : close > pwh ? "Above PWH" : close < pwl ? "Below PWL" : "Inside prev week"

// ============================================================================
//  M4 — AUCTION SHIFT ENGINE  (describe how the auction is evolving)
// ============================================================================
auctionShift = (valueMigration == "Value migrating higher" and acceptUp) ? "Acceptance Above Value" : (valueMigration == "Value migrating lower" and acceptDn) ? "Acceptance Below Value" : valueMigration == "Value migrating higher" ? "Value Migrating Higher" : valueMigration == "Value migrating lower" ? "Value Migrating Lower" : inValueArea ? "Balanced Auction" : strongTrend ? "Trend Auction" : "Rotational Auction"

// ============================================================================
//  M5 — PROFILE SHAPE ENGINE  (classify + explain the volume profile)
// ============================================================================
vaWidthRatio  = (not na(vahPrice) and not na(valPrice) and (rngTop - rngBot) > 0) ? (vahPrice - valPrice) / (rngTop - rngBot) : na
profileWidth  = na(vaWidthRatio) ? "" : vaWidthRatio > 0.65 ? " · Wide (broad acceptance)" : vaWidthRatio < 0.30 ? " · Thin (low acceptance)" : ""
profileShapeExpl = str.startswith(auctionShape, "P") ? "P-shape: often short-covering / accumulation; continuation higher if value holds." : str.startswith(auctionShape, "b") ? "b-shape: often long-liquidation / distribution; continuation lower if value holds." : "D-shape: balanced two-sided auction; expect rotation around POC."

// ============================================================================
//  M2 — STRUCTURE QUALITY ENGINE  (measure, don't just label, structure)
// ============================================================================
structConsistent = structBull or structBear
trendConfidence  = 0.0
trendConfidence += structConsistent ? 35 : 0
trendConfidence += partConfirm ? 20 : 0
trendConfidence += (breakoutUp and structBull) or (breakoutDn and structBear) ? 15 : 0
trendConfidence += (math.abs(vScore) >= 1) and ((vScore >= 0) == (composite >= 0)) ? 15 : 0
trendConfidence += not inValueArea ? 15 : 0
structQualityTxt = not structConsistent ? "Unstable Structure" : trendConfidence >= 80 ? "Healthy Trend" : trendConfidence >= 60 ? "Trending Cleanly" : trendConfidence >= 45 ? "Weak Trend" : volState == "High Volatility" ? "Choppy Structure" : "Exhausted Trend"
structQualityCol = trendConfidence >= 60 and structConsistent ? cBull : not structConsistent ? cTextDim : cBear

// ============================================================================
//  M7 — VOLUME PARTICIPATION QUALITY
// ============================================================================
partQuality    = relVol >= 1.8 ? "Very Strong" : relVol >= 1.2 ? "Healthy" : relVol >= 0.8 ? "Average" : "Weak"
partQualityCol = relVol >= 1.2 ? cBull : relVol < 0.8 ? cBear : cText

// ============================================================================
//  M13 — TRADE QUALITY ENGINE (0-100)
// ----------------------------------------------------------------------------
//  Long and short are scored independently; the higher conviction side wins,
//  but a plan only arms if it clears the user threshold AND structure agrees.
// ============================================================================
longScore = 0.0
longScore += close > vwapD ? 18 : 0
longScore += showVwapW and not na(vwapW) and close > vwapW ? 12 : 0
longScore += not na(pocPrice) and close > pocPrice ? 14 : 0
longScore += trendUp ? 16 : 0
longScore += structBull ? 10 : 0
longScore += pressure > 0.05 ? 12 : 0
longScore += relVol >= 1.0 ? 10 : relVol >= 0.7 ? 5 : 0
longScore += (not na(valPrice) and close >= valPrice and close <= (na(pocPrice) ? close : pocPrice)) ? 8 : 0  // healthy pullback into value

shortScore = 0.0
shortScore += close < vwapD ? 18 : 0
shortScore += showVwapW and not na(vwapW) and close < vwapW ? 12 : 0
shortScore += not na(pocPrice) and close < pocPrice ? 14 : 0
shortScore += trendDn ? 16 : 0
shortScore += structBear ? 10 : 0
shortScore += pressure < -0.05 ? 12 : 0
shortScore += relVol >= 1.0 ? 10 : relVol >= 0.7 ? 5 : 0
shortScore += (not na(vahPrice) and close <= vahPrice and close >= (na(pocPrice) ? close : pocPrice)) ? 8 : 0

bool longSide = longScore >= shortScore
float tradeScore = math.min(math.max(longSide ? longScore : shortScore, 0), 100)
gradeTxt = tradeScore >= 90 ? "A+" : tradeScore >= 80 ? "A" : tradeScore >= 70 ? "B" : tradeScore >= 60 ? "C" : "D"

// Market Quality (is the market worth trading at all — separate from setup) M21
mktQ = 0.0
mktQ += relVol >= 1.0 ? 30 : relVol >= 0.7 ? 15 : 0
mktQ += marketPhase == "Trend Day" or marketPhase == "Opening Drive" ? 30 : (marketPhase == "Balanced Auction" or marketPhase == "Rotational") ? 10 : 20
mktQ += volState == "Normal" ? 20 : volState == "High Volatility" ? 12 : 8
mktQ += not inValueArea ? 20 : 5
mktQText = mktQ >= 80 ? "Excellent" : mktQ >= 65 ? "Good" : mktQ >= 45 ? "Average" : mktQ >= 30 ? "Poor" : "Very Poor"

// ============================================================================
//  M14 / M21 — AI TRADE PLAN (WAIT / BUY ZONE / SELL ZONE)
// ============================================================================
bool armLong  = longSide and longScore >= scoreThreshold and trendUp and not inValueArea and phaseAllowsTrend
bool armShort = (not longSide) and shortScore >= scoreThreshold and trendDn and not inValueArea and phaseAllowsTrend

planStatus = armLong ? "BUY PLAN READY" : armShort ? "SELL PLAN READY" : (longScore >= scoreThreshold - 12 and trendUp) ? "BUY SETUP FORMING" : (shortScore >= scoreThreshold - 12 and trendDn) ? "SELL SETUP FORMING" : "WAIT"

// ============================================================================
//  DECISION ENGINE — flows Phase → Auction → Structure → VWAP → Participation
//  Pure explanation, never prediction; no new indicators.
// ============================================================================
// ---- Institutional Confluence (how many pillars agree with the active bias) ----
biasBull  = biasScore >= 0
cfVWAP    = (close > vwapD) == biasBull
cfPOC     = not na(pocPrice) and ((close > pocPrice) == biasBull)
cfTrend   = biasBull ? trendUp : trendDn
cfVol     = relVol >= 1.0
cfMom     = biasBull ? (pressure > 0.05) : (pressure < -0.05)
cfPA      = biasBull ? structBull : structBear
confCount = (cfVWAP ? 1 : 0) + (cfPOC ? 1 : 0) + (cfTrend ? 1 : 0) + (cfVol ? 1 : 0) + (cfMom ? 1 : 0) + (cfPA ? 1 : 0)
confStars = math.max(math.round(confCount / 6.0 * 5), confCount > 0 ? 1 : 0)
confColor = confCount >= 5 ? cBull : confCount >= 3 ? cText : cTextDim

// ---- Market Energy (0-100): participation, VWAP slope, ATR expansion, trend, pressure ----
energy = 0.0
energy += relVol >= 1.5 ? 25 : relVol >= 1.0 ? 16 : relVol >= 0.7 ? 8 : 0
energy += math.abs(vwapSlope) > 0.15 ? 20 : math.abs(vwapSlope) > 0.06 ? 12 : 4
energy += atrPct > atrPctMa * 1.2 ? 20 : atrPct > atrPctMa * 0.9 ? 12 : 5
energy += trendStr >= 2.5 ? 20 : trendStr >= 1.5 ? 12 : 5
energy += math.abs(pressure) > 0.4 ? 15 : math.abs(pressure) > 0.15 ? 9 : 3
energyTxt   = energy >= 80 ? "Very High" : energy >= 60 ? "High" : energy >= 40 ? "Normal" : energy >= 25 ? "Low" : "Very Low"
energyColor = energy >= 60 ? cBull : energy >= 40 ? cText : cTextDim

// ---- AI Decision (guidance, never BUY/SELL arrows); phase gates everything ----
nearRes = not na(lastResistance) and lastResistance > close and (lastResistance - close) / (atr14 == 0 ? syminfo.mintick : atr14) < 0.6
nearSup = not na(lastSupport)    and lastSupport    < close and (close - lastSupport)    / (atr14 == 0 ? syminfo.mintick : atr14) < 0.6
decisionTxt = posState == "Long" ? ((trendDn or pressure < -0.1) ? "EXIT POSITION" : (nearRes or (not na(vahPrice) and close >= vahPrice)) ? "TAKE PARTIAL" : (close > vwapD and trendUp) ? "MANAGE POSITION" : "MOVE STOP") : posState == "Short" ? ((trendUp or pressure > 0.1) ? "EXIT POSITION" : (nearSup or (not na(valPrice) and close <= valPrice)) ? "TAKE PARTIAL" : (close < vwapD and trendDn) ? "MANAGE POSITION" : "MOVE STOP") : armLong ? "BUY PULLBACK" : armShort ? "SELL RETEST" : str.contains(planStatus, "SETUP") ? "WATCH" : (energy < 25 or not phaseAllowsTrend) ? "NO TRADE" : "WAIT"
decisionColor = str.contains(decisionTxt, "BUY") or decisionTxt == "MANAGE POSITION" ? cBull : str.contains(decisionTxt, "SELL") or decisionTxt == "EXIT POSITION" ? cBear : (str.contains(decisionTxt, "PARTIAL") or decisionTxt == "MOVE STOP" or decisionTxt == "WATCH") ? cVah : cTextDim
// ---- M9: DYNAMIC CONFIDENCE — weighted Auction 35 / Structure 25 / Participation 20 / VWAP 20 ----
biasSign = composite >= 0 ? 1.0 : -1.0
agA = ((aScore >= 0 ? 1.0 : -1.0) == biasSign) ? math.min(math.abs(aScore) / 2.0, 1.0) : 0.0
agS = ((structScore >= 0 ? 1.0 : -1.0) == biasSign) ? math.min(math.abs(structScore) / 2.0, 1.0) : 0.0
agV = ((vScore >= 0 ? 1.0 : -1.0) == biasSign) ? math.min(math.abs(vScore) / 2.0, 1.0) : 0.0
agP = (partConfirm and ((partBias >= 0 ? 1.0 : -1.0) == biasSign)) ? 1.0 : (partConfirm ? 0.4 : 0.2)
confidenceRaw = agA * 35 + agS * 25 + agP * 20 + agV * 20
confidencePct = math.round(math.min(confidenceRaw * (volState == "Low Volatility" ? 0.85 : 1.0) * phaseMult, 100))
confidenceTxt = confidencePct >= 70 ? "High" : confidencePct >= 50 ? "Medium" : "Low"

// ---- M8: PROFESSIONAL CONTEXT ENGINE — concise plain-English auction summary ----
f_decisionReason() =>
    string r = "Phase: " + marketPhase + "\n"
    r += "Memory: " + memOpenLoc + " · " + memPOCdir + "\n"
    r += valueMigration != "—" ? valueMigration + " · " + pdAccept + " · " + pwAccept + "\n" : pdAccept + " · " + pwAccept + "\n"
    r += "Price " + priceVsValue + " · VWAP " + vwapStateTxt + " (" + vwapContext + ").\n"
    r += "Auction: " + auctionShift + " (" + auctionTxt + ").\n"
    r += "Structure: " + structQualityTxt + " · Participation: " + partQuality + " (" + partTxt + ").\n"
    r += "──────────────\n"
    r += composite >= 0.18 ? "→ Environment favors upside continuation." : composite <= -0.18 ? "→ Environment favors downside continuation." : "→ Two-sided auction; no clear edge."
    r

// ============================================================================
//  M15 — PROFESSIONAL DASHBOARD
// ============================================================================
f_hdr(tbl, sz, row, txt) =>
    table.cell(tbl, 0, row, txt, text_color=cText, text_size=sz, text_halign=text.align_left, bgcolor=cPanelHdr)
    table.cell(tbl, 1, row, "", bgcolor=cPanelHdr)

f_row(tbl, sz, row, k, v, vcol) =>
    table.cell(tbl, 0, row, k, text_color=cTextDim, text_size=sz, text_halign=text.align_left)
    table.cell(tbl, 1, row, v, text_color=vcol, text_size=sz, text_halign=text.align_right)

// Auction display — how the auction is evolving (+ any poor-high/low warning)
auctionCol  = auctionColor
auctionDisp = auctionShift + (poorHigh ? "  ⚠PH" : "") + (poorLow ? "  ⚠PL" : "")

var table dash = na
if barstate.islast and showDash
    if not na(dash)
        table.delete(dash)
    sz = f_txtSize(dashSize)
    int nRows = (3 + (showAuction ? 2 : 0)) + 4 + 6 + 5 + 6 + (showMTFpoc ? 4 : 0) + (showSession ? 4 : 0)
    dash := table.new(f_tblPos(dashPos), 2, nRows, bgcolor=cPanelBg, frame_color=cFrame, frame_width=1, border_color=cGrid, border_width=0)
    int r = 0

    f_hdr(dash, sz, r, "◆  VOLUME FLOW PRO X AI")
    r += 1
    f_row(dash, sz, r, "Trend (composite)", marketBias, biasColor)
    r += 1
    if showAuction
        f_row(dash, sz, r, "Phase", marketPhase, marketPhaseColor)
        r += 1
        table.cell(dash, 0, r, "Auction", text_color=cTextDim, text_size=sz, text_halign=text.align_left)
        table.cell(dash, 1, r, auctionDisp, text_color=auctionCol, text_size=sz, text_halign=text.align_right, tooltip="Profile " + auctionShape + profileWidth + " — " + profileShapeExpl)
        r += 1
    f_row(dash, sz, r, "Structure", structureTxt, structQualityCol)
    r += 1

    f_hdr(dash, sz, r, "◆  VWAP")
    r += 1
    f_row(dash, sz, r, "Price", f_px(close), cText)
    r += 1
    f_row(dash, sz, r, "Daily VWAP", f_px(vwapD) + (close > vwapD ? "  ▲" : "  ▼"), close > vwapD ? cBull : cBear)
    r += 1
    f_row(dash, sz, r, "Weekly VWAP", na(vwapW) ? "—" : f_px(vwapW), cTextDim)
    r += 1

    f_hdr(dash, sz, r, "◆  VOLUME PROFILE")
    r += 1
    f_row(dash, sz, r, "POC", na(pocPrice) ? "—" : f_px(pocPrice), cPoc)
    r += 1
    f_row(dash, sz, r, "VAH", na(vahPrice) ? "—" : f_px(vahPrice), cVah)
    r += 1
    f_row(dash, sz, r, "VAL", na(valPrice) ? "—" : f_px(valPrice), cVal)
    r += 1
    f_row(dash, sz, r, "Nearest HVN", na(hvn1) ? "—" : f_px(hvn1), cHvn)
    r += 1
    f_row(dash, sz, r, "Nearest LVN", na(lvn1) ? "—" : f_px(lvn1), cLvn)
    r += 1

    if showMTFpoc
        f_hdr(dash, sz, r, "◆  MULTI-TIMEFRAME POC")
        r += 1
        f_row(dash, sz, r, "Daily POC", na(dPOC) ? "—" : f_px(dPOC), cPoc)
        r += 1
        f_row(dash, sz, r, "Weekly POC", na(wPOC) ? "—" : f_px(wPOC), cPoc)
        r += 1
        f_row(dash, sz, r, "Monthly POC", na(mPOC) ? "—" : f_px(mPOC), cPoc)
        r += 1

    f_hdr(dash, sz, r, "◆  FLOW")
    r += 1
    f_row(dash, sz, r, "Participation", partQuality, partQualityCol)
    r += 1
    f_row(dash, sz, r, "Buyers / Sellers", str.tostring(buyersPct) + "% / " + str.tostring(sellersPct) + "%", flowColor)
    r += 1
    f_row(dash, sz, r, "Pressure", pressureTxt, pressureColor)
    r += 1
    f_row(dash, sz, r, "Market Quality", mktQText, mktQ >= 65 ? cBull : mktQ >= 45 ? cText : cBear)
    r += 1

    if showSession
        f_hdr(dash, sz, r, "◆  SESSION")
        r += 1
        f_row(dash, sz, r, "Active", activeSession, cText)
        r += 1
        f_row(dash, sz, r, "ADR / Used", (na(adr) ? "—" : f_px(adr)) + (na(rangeUsedPct) ? "" : "  " + str.tostring(rangeUsedPct) + "%"), na(rangeUsedPct) ? cTextDim : rangeUsedPct >= 100 ? cBear : cText)
        r += 1
        f_row(dash, sz, r, "vs Yesterday", valueMigration == "—" ? "—" : valueMigration, memColor)
        r += 1

    f_hdr(dash, sz, r, "◆  AI DECISION")
    r += 1
    table.cell(dash, 0, r, "Decision", text_color=cTextDim, text_size=sz, text_halign=text.align_left)
    table.cell(dash, 1, r, decisionTxt, text_color=decisionColor, text_size=sz, text_halign=text.align_right, bgcolor=color.new(decisionColor, 88))
    r += 1
    f_row(dash, sz, r, "Confluence", str.tostring(confCount) + "/6  " + (confCount > 0 ? f_stars(confStars) : "—"), confColor)
    r += 1
    f_row(dash, sz, r, "Energy", energyTxt, energyColor)
    r += 1
    f_row(dash, sz, r, "Risk", riskTxt, riskColor)
    r += 1
    f_row(dash, sz, r, "Confidence", str.tostring(confidencePct) + "%  " + confidenceTxt, confidencePct >= 70 ? cBull : confidencePct >= 50 ? cText : cTextDim)

// ---- On-chart decision tag (minimal — decision + confidence + reasons) ----
var label planLbl = na
if barstate.islast and showPlanLbl and decisionTxt != "WAIT" and decisionTxt != "NO TRADE"
    label.delete(planLbl)
    string body = decisionTxt + "   (Confidence: " + confidenceTxt + ")\n"
    body += "──────────────\n" + f_decisionReason()
    planLbl := label.new(bar_index, low - atr14*1.2, body, xloc=xloc.bar_index, style=label.style_label_up, color=color.new(decisionColor, 12), textcolor=color.white, size=size.small, textalign=text.align_left)

// ============================================================================
//  AI MORNING BRIEF  (institutional pre-trade plan, M21)
// ============================================================================
var table brief = na
if barstate.islast and showBrief
    if not na(brief)
        table.delete(brief)
    bsz = f_txtSize(dashSize)
    brief := table.new(f_tblPos(briefPos), 2, 9, bgcolor=cPanelBg, frame_color=cFrame, frame_width=1, border_color=cGrid, border_width=0)
    f_hdr(brief, bsz, 0, "◆  AI MORNING BRIEF")
    f_row(brief, bsz, 1, "Bias", marketBias, biasColor)
    f_row(brief, bsz, 2, "Phase", marketPhase, marketPhaseColor)
    f_row(brief, bsz, 3, "Preferred Buy", (na(valPrice) or na(pocPrice)) ? "—" : f_px(valPrice) + "–" + f_px(pocPrice), cBull)
    f_row(brief, bsz, 4, "Preferred Sell", (na(pocPrice) or na(vahPrice)) ? "—" : f_px(pocPrice) + "–" + f_px(vahPrice), cBear)
    f_row(brief, bsz, 5, "Expected Range", (na(expLow) or na(expHigh)) ? "—" : f_px(expLow) + "–" + f_px(expHigh), cText)
    f_row(brief, bsz, 6, "Best Session", bestSession, cText)
    f_row(brief, bsz, 7, "Decision", decisionTxt, decisionColor)
    f_row(brief, bsz, 8, "Confidence", str.tostring(confidencePct) + "%  " + confidenceTxt, confidencePct >= 70 ? cBull : confidencePct >= 50 ? cText : cTextDim)

// ============================================================================
//  RANKED KEY LEVELS  (top 5 strongest, by strength then proximity)
// ============================================================================
var table keyT = na
if barstate.islast and showKeyPanel
    if not na(keyT)
        table.delete(keyT)
    ksz = f_txtSize(dashSize)
    prices = array.new_float()
    names  = array.new_string()
    stars  = array.new_int()
    f_addLvl(prices, names, stars, wPOC, "Weekly POC", 5)
    f_addLvl(prices, names, stars, mPOC, "Monthly POC", 5)
    f_addLvl(prices, names, stars, showVwapM ? vwapM : na, "Monthly VWAP", 5)
    f_addLvl(prices, names, stars, vwapD, "Daily VWAP", 4)
    f_addLvl(prices, names, stars, vwapW, "Weekly VWAP", 4)
    f_addLvl(prices, names, stars, dPOC, "Daily POC", 4)
    f_addLvl(prices, names, stars, vahPrice, "VAH", 3)
    f_addLvl(prices, names, stars, valPrice, "VAL", 3)
    f_addLvl(prices, names, stars, hvn1, "HVN", 3)
    f_addLvl(prices, names, stars, pdh, "PDH", 3)
    f_addLvl(prices, names, stars, pdl, "PDL", 3)
    f_addLvl(prices, names, stars, lvn1, "LVN", 2)

    int n = array.size(prices)
    weights = array.new_float(n, -1e30)
    for i = 0 to (n > 0 ? n - 1 : 0)
        if i < n
            float d = math.abs(close - array.get(prices, i)) / syminfo.mintick
            array.set(weights, i, array.get(stars, i) * 100000.0 - d)
    int showN = math.min(5, n)
    keyT := table.new(f_tblPos(keyPos), 3, showN + 1, bgcolor=cPanelBg, frame_color=cFrame, frame_width=1, border_color=cGrid, border_width=0)
    table.cell(keyT, 0, 0, "◆  KEY LEVELS", text_color=cText, text_size=ksz, text_halign=text.align_left, bgcolor=cPanelHdr)
    table.cell(keyT, 1, 0, "", bgcolor=cPanelHdr)
    table.cell(keyT, 2, 0, "", bgcolor=cPanelHdr)
    for rank = 1 to showN
        int best = -1
        float bestW = -1e30
        for i = 0 to n - 1
            float w = array.get(weights, i)
            if w > bestW
                bestW := w
                best := i
        if best >= 0
            float p  = array.get(prices, best)
            string nm = array.get(names, best)
            int st   = array.get(stars, best)
            table.cell(keyT, 0, rank, nm, text_color=cTextDim, text_size=ksz, text_halign=text.align_left)
            table.cell(keyT, 1, rank, f_stars(st), text_color=cPoc, text_size=ksz, text_halign=text.align_center)
            table.cell(keyT, 2, rank, f_px(p), text_color=p >= close ? cRes : cSup, text_size=ksz, text_halign=text.align_right)
            array.set(weights, best, -1e30)

// ============================================================================
//  MODULE 1 — AI MARKET GPS  (where price sits inside today's auction)
// ============================================================================
var table gps = na
if barstate.islast and showGPS
    if not na(gps)
        table.delete(gps)
    gsz = f_txtSize(dashSize)
    gps := table.new(f_tblPos(gpsPos), 2, 9, bgcolor=cPanelBg, frame_color=cFrame, frame_width=1, border_color=cGrid, border_width=0)
    vaPos   = na(vahPrice) ? "—" : close > vahPrice ? "Above VAH" : close < valPrice ? "Below VAL" : close >= pocPrice ? "Upper Value" : "Lower Value"
    vaCol   = na(vahPrice) ? cTextDim : close > vahPrice ? cBull : close < valPrice ? cBear : cText
    pdPos   = na(pdh) ? "—" : close > pdh ? "Above PDH" : close < pdl ? "Below PDL" : "Inside Prev Day"
    nodeTxt = not na(hvn1) and math.abs(close - hvn1) / (atr14 == 0 ? syminfo.mintick : atr14) < 0.4 ? "At HVN (acceptance)" : not na(lvn1) and math.abs(close - lvn1) / (atr14 == 0 ? syminfo.mintick : atr14) < 0.4 ? "At LVN (fast move)" : "Between nodes"
    f_hdr(gps, gsz, 0, "◆  MARKET GPS")
    f_row(gps, gsz, 1, "Daily VWAP",    close > vwapD ? "Above" : "Below", close > vwapD ? cBull : cBear)
    f_row(gps, gsz, 2, "Weekly VWAP",   na(vwapW) ? "—" : (close > vwapW ? "Above" : "Below"), na(vwapW) ? cTextDim : close > vwapW ? cBull : cBear)
    f_row(gps, gsz, 3, "Anchored VWAP", (not showAnchored or na(vwapA)) ? "—" : (close > vwapA ? "Above" : "Below"), (not showAnchored or na(vwapA)) ? cTextDim : close > vwapA ? cBull : cBear)
    f_row(gps, gsz, 4, "POC",           na(pocPrice) ? "—" : (close > pocPrice ? "Above" : "Below"), na(pocPrice) ? cTextDim : close > pocPrice ? cBull : cBear)
    f_row(gps, gsz, 5, "Value Area",    vaPos, vaCol)
    f_row(gps, gsz, 6, "Prev Day",      pdPos, na(pdh) ? cTextDim : close > pdh ? cBull : close < pdl ? cBear : cText)
    f_row(gps, gsz, 7, "Nodes",         nodeTxt, cText)
    f_row(gps, gsz, 8, "Confluence",    str.tostring(confCount) + "/6", confColor)

// ============================================================================
//  M16 — SMART ALERTS
// ============================================================================
crossUpVwap   = ta.crossover(close, vwapD)
crossDnVwap   = ta.crossunder(close, vwapD)
vwapBounce    = low <= vwapD and close > vwapD and close > open and relVol >= 1.0
vwapReject    = high >= vwapD and close < vwapD and close < open and relVol >= 1.0
pocBreakUp    = not na(pocPrice) and ta.crossover(close, pocPrice)
pocBreakDn    = not na(pocPrice) and ta.crossunder(close, pocPrice)
enterValue    = not na(vahPrice) and not na(valPrice) and (close <= vahPrice and close >= valPrice) and not (close[1] <= vahPrice and close[1] >= valPrice)

alertcondition(crossUpVwap, "VWAP Break Up", "VF Pro X AI: price broke above Daily VWAP")
alertcondition(crossDnVwap, "VWAP Break Down", "VF Pro X AI: price broke below Daily VWAP")
alertcondition(vwapBounce, "VWAP Bounce", "VF Pro X AI: bullish VWAP bounce")
alertcondition(vwapReject, "VWAP Rejection", "VF Pro X AI: bearish VWAP rejection")
alertcondition(pocBreakUp, "POC Break Up", "VF Pro X AI: price broke above POC")
alertcondition(pocBreakDn, "POC Break Down", "VF Pro X AI: price broke below POC")
alertcondition(enterValue, "Entered Value Area", "VF Pro X AI: price entered the Value Area")
alertcondition(armLong, "Buy Plan Ready", "VF Pro X AI: BUY PLAN READY")
alertcondition(armShort, "Sell Plan Ready", "VF Pro X AI: SELL PLAN READY")
alertcondition(tradeScore >= scoreThreshold, "Trade Score Threshold", "VF Pro X AI: trade score crossed your threshold")
