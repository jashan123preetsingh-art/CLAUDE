# ─────────────────────────────────────────────────────────────
#  AI Swing Trading Screener — configuration
#  Copy to `.env` and fill in real credentials for live data.
# ─────────────────────────────────────────────────────────────

# Active market-data provider: synthetic | upstox | dhan | angelone | shoonya
DATA_PROVIDER=synthetic

# --- Upstox ---
UPSTOX_API_KEY=
UPSTOX_API_SECRET=
UPSTOX_ACCESS_TOKEN=

# --- Dhan ---
DHAN_CLIENT_ID=
DHAN_ACCESS_TOKEN=

# --- Angel One SmartAPI ---
ANGELONE_API_KEY=
ANGELONE_CLIENT_CODE=
ANGELONE_PASSWORD=
ANGELONE_TOTP_SECRET=

# --- Shoonya (Finvasia) ---
SHOONYA_USER_ID=
SHOONYA_PASSWORD=
SHOONYA_API_KEY=
SHOONYA_TOTP_SECRET=

# --- News / sentiment ---
NEWS_API_KEY=

# --- Infrastructure (optional; app degrades gracefully if absent) ---
DATABASE_URL=postgresql+psycopg://screener:screener@localhost:5432/screener
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1

# --- Alerts ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ALERT_EMAIL_TO=

# --- Scan tuning ---
UNIVERSE_LIMIT=200          # cap symbols scanned per run (0 = no cap)
HISTORY_DAYS=400            # daily candles pulled per symbol
MAX_CONCURRENCY=16         # concurrent provider requests
CACHE_TTL_SECONDS=900
LOG_LEVEL=INFO
